                    if [[ "$OPT_SDDM" == true ]]; then OPT_SDDM=false; else OPT_SDDM=true; fi ;;
                "3")
                    if [[ "$INSTALL_FULL_WALLPAPERS" == true ]]; then INSTALL_FULL_WALLPAPERS=false; else INSTALL_FULL_WALLPAPERS=true; fi ;;
                "4")
                    if [[ ${#SELECTED_COMPOSITORS[@]} -eq 0 ]]; then
                        log_error 'Выберите compositor'
                        sleep 1
                        continue
                    fi
                    return 0
                    ;;
                "5"|ESC|[qQ])
                    return 1
                    ;;
                ENTER|SPACE)
                    case "$cursor" in
                        0) manage_compositors_menu; break ;;
                        1) if [[ "$OPT_SDDM" == true ]]; then OPT_SDDM=false; else OPT_SDDM=true; fi ;;
                        2) if [[ "$INSTALL_FULL_WALLPAPERS" == true ]]; then INSTALL_FULL_WALLPAPERS=false; else INSTALL_FULL_WALLPAPERS=true; fi ;;
                        3)
                            if [[ ${#SELECTED_COMPOSITORS[@]} -eq 0 ]]; then
                                log_error 'Выберите compositor'
                                sleep 1
                                continue
                            fi
                            return 0
                            ;;
                        4) return 1 ;;
                    esac
                    ;;
            esac
        done
    done
}

usage() {
    cat <<EOF_USAGE
linka ${LINKA_VERSION} — Serpantinum installer (Fedora/Gentoo)

  linka                       меню
  linka install               установка (поверх существующей — без затирания конфигов)
  linka reinstall             чистая переустановка (конфиги бэкапятся)
  linka update                обновление
  linka update --force        принудительное обновление поверх текущего коммита
  linka rollback              откат файлов оболочки и настроек (без пакетов ОС)
  linka doctor                диагностика без изменений
  linka update --dry-run       план действий без изменений (также install, reinstall, remove, rollback)
  linka remove                удаление
  linka kill                  остановка

Фоновое автообновление:
  linka auto enable [опции]   включить (таймер systemd --user или демон)
  linka auto disable          выключить
  linka auto status           состояние и последние строки журнала
  linka auto run [-v]         один проход (его вызывает таймер); -v — вывод на экран
  linka auto daemon           цикл в фоне (для систем без systemd --user)

  Опции auto enable:
    --shell apply|notify|off  Serpantinum: обновлять сам / только уведомлять / не трогать (apply)
    --system off|notify|apply пакеты ОС (dnf / emerge): не трогать / уведомлять / обновлять (off)
    --interval МИНУТЫ         как часто проверять (15)
    --every-days ДНИ          как часто трогать пакеты ОС (1)
    --no-notify               без уведомлений

Переменные окружения:
  SERPANTINUM_BRANCH=master   ветка репозитория (по умолчанию master)
  SERPANTINUM_FORCE_UPDATE=1  то же, что update --force
  SERPANTINUM_MATUGEN_COMPAT=0  отключить автоправку совместимости с matugen
  LINKA_BACKUP_KEEP=5         сколько последних бэкапов хранить (0 — не удалять)
EOF_USAGE
}

linka_main_menu() {
    if [[ ! -t 0 ]]; then
        log_warn 'Нет интерактивного TTY.'
        usage
        return 0
    fi

    load_state
    init_compositor_detection
    OLD_VERSION="$(get_installed_version 2>/dev/null || echo "2.2.4")"
    TARGET_VERSION="$(get_target_version "$CACHE_BASE" 2>/dev/null || echo "$OLD_VERSION")"
    TARGET_COMMIT="$(get_installed_commit 2>/dev/null || echo "unknown")"
    INSTALL_STATE="$(detect_install_state)"


    local cursor=0
    if [[ "$INSTALL_STATE" == "current" ]]; then
        cursor=5
    fi

    stty -echo icanon 2>/dev/null || true
    printf "\e[?25l" 2>/dev/null || true

    while true; do
        draw_banner
        local rendered_lines=0

        while true; do
            local comp_str
            comp_str="$(selected_compositors_string)"
            local comp_item
            if [[ -z "$comp_str" ]]; then
                comp_item="${C_RED}(не выбран)${RESET}"
            else
                comp_item="${C_GREEN}(${comp_str})${RESET}"
            fi

            local s_sddm="${DIM}[OFF]${RESET}"
            local s_wp="${DIM}[3 Random]${RESET}"
            local s_auto="${DIM}[OFF]${RESET}"

            [[ "$OPT_SDDM" == true ]] && s_sddm="${C_GREEN}[ON]${RESET}"
            [[ "$INSTALL_FULL_WALLPAPERS" == true ]] && s_wp="${C_GREEN}[Full Pack]${RESET}"
            if auto_is_enabled 2>/dev/null; then
                s_auto="${C_GREEN}[ON]${RESET}"
            fi

            local pkg_count="${#REQUIRED_PKGS[@]}"

            local items=()
            items+=("1. Обзор установки пакетов ($pkg_count основных пакетов)")
            items+=("2. Целевой композитор $comp_item")
            items+=("3. Дисплейный менеджер SDDM $s_sddm")
            items+=("4. Набор обоев $s_wp")
            items+=("5. Фоновое автообновление $s_auto")

            if [[ "$INSTALL_STATE" == "current" ]]; then
                items+=("6. ${BOLD}${C_GREEN}Обновить${RESET}")
                items+=("7. ${BOLD}${C_YELLOW}Переустановить${RESET}")
                items+=("8. ${DIM}Выход${RESET}")
            else
                items+=("6. ${BOLD}${C_GREEN}Установить${RESET}")
                items+=("7. ${DIM}Выход${RESET}")
            fi

            if [[ "$rendered_lines" -gt 0 ]]; then
                printf "\033[%dA" "$rendered_lines"
            fi

            for i in "${!items[@]}"; do
                if [[ "$i" -eq "$cursor" ]]; then
                    printf "\r\033[K  %s%s>%s %s\n" "$BOLD" "$C_CYAN" "$RESET" "${items[$i]}"
                else
                    printf "\r\033[K    %s\n" "${items[$i]}"
                fi
            done
            rendered_lines=${#items[@]}

            local k
            k="$(read_key)"

            case "$k" in
                UP|[kK])
                    if [[ "$cursor" -gt 0 ]]; then
                        cursor=$((cursor - 1))
                    else
                        cursor=$(( ${#items[@]} - 1 ))
                    fi
                    ;;
                DOWN|[jJ])
                    if [[ "$cursor" -lt $(( ${#items[@]} - 1 )) ]]; then
                        cursor=$((cursor + 1))
                    else
                        cursor=0
                    fi
                    ;;
                "1")
                    show_package_overview
                    break
                    ;;
                "2")
                    manage_compositors_menu
                    break
                    ;;
                "3")
                    if [[ "$OPT_SDDM" == true ]]; then OPT_SDDM=false; else OPT_SDDM=true; fi
                    ;;
                "4")
                    if [[ "$INSTALL_FULL_WALLPAPERS" == true ]]; then INSTALL_FULL_WALLPAPERS=false; else INSTALL_FULL_WALLPAPERS=true; fi
                    ;;
                "5")
                    cleanup_terminal
                    auto_menu
                    stty -echo icanon 2>/dev/null || true
                    printf "\e[?25l" 2>/dev/null || true
                    break
                    ;;
                "6")
                    cleanup_terminal
                    SKIP_INSTALLER_UI=true
                    if [[ "$INSTALL_STATE" == "current" ]]; then
                        FORCE_UPDATE=0
                        prepare_environment
                        linka_run_reported update flow_update || true
                    else
                        FORCE_UPDATE=0
                        prepare_environment
                        linka_run_reported install flow_install install || true
                    fi
                    SKIP_INSTALLER_UI=false
                    end_session
                    read -r -p 'Нажмите Enter для продолжения...' _ || true
                    stty -echo icanon 2>/dev/null || true
                    printf "\e[?25l" 2>/dev/null || true
                    break
                    ;;
                "7")
                    if [[ "$INSTALL_STATE" == "current" ]]; then
                        cleanup_terminal
                        SKIP_INSTALLER_UI=true
                        FORCE_UPDATE=0
                        prepare_environment
                        linka_run_reported reinstall flow_install reinstall || true
                        SKIP_INSTALLER_UI=false
                        end_session
                        read -r -p 'Нажмите Enter для продолжения...' _ || true
                        stty -echo icanon 2>/dev/null || true
                        printf "\e[?25l" 2>/dev/null || true
                        break
                    else
                        cleanup_terminal
                        return 0
                    fi
                    ;;
                "8")
                    if [[ "$INSTALL_STATE" == "current" ]]; then
                        cleanup_terminal
                        return 0
                    fi
                    ;;
                ENTER|SPACE)
                    case "$cursor" in
                        0)
                            show_package_overview
                            break
                            ;;
                        1)
                            manage_compositors_menu
                            break
                            ;;
                        2)
                            if [[ "$OPT_SDDM" == true ]]; then OPT_SDDM=false; else OPT_SDDM=true; fi
                            ;;
                        3)
                            if [[ "$INSTALL_FULL_WALLPAPERS" == true ]]; then INSTALL_FULL_WALLPAPERS=false; else INSTALL_FULL_WALLPAPERS=true; fi
                            ;;
                        4)
                            cleanup_terminal
                            auto_menu
                            stty -echo icanon 2>/dev/null || true
                            printf "\e[?25l" 2>/dev/null || true
                            break
                            ;;
                        5)
                            cleanup_terminal
                            SKIP_INSTALLER_UI=true
                            if [[ "$INSTALL_STATE" == "current" ]]; then
                                FORCE_UPDATE=0
                                prepare_environment
                                linka_run_reported update flow_update || true
                            else
                                FORCE_UPDATE=0
                                prepare_environment
                                linka_run_reported install flow_install install || true
                            fi
                            SKIP_INSTALLER_UI=false
                            end_session
                            read -r -p 'Нажмите Enter для продолжения...' _ || true
                            stty -echo icanon 2>/dev/null || true
                            printf "\e[?25l" 2>/dev/null || true
                            break
                            ;;
                        6)
                            if [[ "$INSTALL_STATE" == "current" ]]; then
                                cleanup_terminal
                                SKIP_INSTALLER_UI=true
                                FORCE_UPDATE=0
                                prepare_environment
                                linka_run_reported reinstall flow_install reinstall || true
                                SKIP_INSTALLER_UI=false
                                end_session
                                read -r -p 'Нажмите Enter для продолжения...' _ || true
                                stty -echo icanon 2>/dev/null || true
                                printf "\e[?25l" 2>/dev/null || true
                                break
                            else
                                cleanup_terminal
                                return 0
                            fi
                            ;;
                        7)
                            cleanup_terminal
                            return 0
                            ;;
                    esac
                    ;;
                [sS]|kill)
                    cleanup_terminal
                    read -r -p 'Остановить Quickshell? [y/N] ' confirm_stop || true
                    if [[ "$confirm_stop" =~ ^[Yy]$ ]]; then
                        kill_serpantinum || true
                        end_session
                        read -r -p 'Нажмите Enter для продолжения...' _ || true
                    fi
                    stty -echo icanon 2>/dev/null || true
                    printf "\e[?25l" 2>/dev/null || true
                    break
                    ;;
                [dD])
                    cleanup_terminal
                    linka_doctor || true
                    read -r -p 'Нажмите Enter для продолжения...' _ || true
                    stty -echo icanon 2>/dev/null || true
                    printf "\e[?25l" 2>/dev/null || true
                    break
                    ;;
                [rR])
                    cleanup_terminal
                    read -r -p 'Откатить файлы оболочки и настройки? [y/N] ' confirm_rollback || true
                    if [[ "$confirm_rollback" =~ ^[Yy]$ ]]; then
                        acquire_lock
                        linka_recover_transaction && linka_run_reported rollback linka_rollback || true
                        end_session
                    fi
                    read -r -p 'Нажмите Enter для продолжения...' _ || true
                    stty -echo icanon 2>/dev/null || true
                    printf "\e[?25l" 2>/dev/null || true
                    break
                    ;;
                ESC|[qQ])
                    cleanup_terminal
                    return 0
                    ;;
            esac
        done
    done
}

auto_get() {
    local v=""
    if [[ -f "$AUTO_CONF" ]]; then
        v="$(K="$1" awk -F= 'BEGIN{k=ENVIRON["K"]} $1==k{sub(/^[^=]*=/,""); print; exit}' "$AUTO_CONF" 2>/dev/null || true)"
    fi
    printf '%s\n' "${v:-${2:-}}"
    return 0
}

auto_set() {
    local key="$1" val tmp
    val="$(printf '%s' "$2" | tr '\n\r' '  ')"
    mkdir -p "$STATE_DIR"
    tmp="$(mktemp "$STATE_DIR/.auto.XXXXXX")"

    if [[ -f "$AUTO_CONF" ]]; then
        K="$key" V="$val" awk -F= '
            BEGIN{f=0; k=ENVIRON["K"]; v=ENVIRON["V"]}
            $1==k{print k"="v; f=1; next}
            {print}
            END{if(!f) print k"="v}
        ' "$AUTO_CONF" > "$tmp"
    else
        printf '%s=%s\n' "$key" "$val" > "$tmp"
    fi

    chmod 600 "$tmp"
    mv -f "$tmp" "$AUTO_CONF"
    return 0
}

auto_valid_mode() {
    case "$1" in
        off|notify|apply) return 0 ;;
    esac
    return 1
}

auto_valid_uint() {
    [[ "$1" =~ ^[0-9]+$ ]] && [[ "$((10#$1))" -gt 0 ]]
}

auto_notify() {
    if [[ "$(auto_get AUTO_NOTIFY 1)" != 1 ]]; then
        return 0
    fi
    if ! command -v notify-send >/dev/null 2>&1; then
        return 0
    fi
    notify-send -a linka -u "${3:-normal}" "$1" "$2" >/dev/null 2>&1 || true
    return 0
}

auto_setup_log() {
    local sz
    mkdir -p "$STATE_DIR"

    if [[ -f "$AUTO_LOG" ]]; then
        sz="$(stat -c %s "$AUTO_LOG" 2>/dev/null || echo 0)"
        if [[ "$sz" -gt "$AUTO_LOG_MAX" ]]; then
            mv -f "$AUTO_LOG" "$AUTO_LOG.1" 2>/dev/null || true
        fi
    fi

    exec >>"$AUTO_LOG" 2>&1
    return 0
}

acquire_lock_quiet() {
    if ! command -v flock >/dev/null 2>&1; then
        return 0
    fi

    exec 9>"$LOCK_FILE" || return 0

    if ! flock -n 9; then
        exec 9>&- 2>/dev/null || true
        return 1
    fi

    return 0
}

auto_network_ok() {
    curl -fsSI --connect-timeout 5 --max-time 15 https://github.com >/dev/null 2>&1
}

auto_adopt_session_env() {
    local pid="" line

    pid="$(pgrep -f "$TARGET_BASE/src/quickshell" 2>/dev/null | head -n1 || true)"
    if [[ -z "$pid" ]]; then
        pid="$({ pgrep -f "$TARGET_BASE/bin/serpantinumd" || pgrep -f "$BIN_DIR/serpantinumd"; } 2>/dev/null | head -n1 || true)"
    fi
    if [[ -z "$pid" ]]; then
        pid="$({ pgrep -x niri || pgrep -x Hyprland || pgrep -x sway || pgrep -x mango; } 2>/dev/null | head -n1 || true)"
    fi

    if [[ -z "$pid" || ! -r "/proc/$pid/environ" ]]; then
        return 1
    fi

    while IFS= read -r -d '' line; do
        case "$line" in
            WAYLAND_DISPLAY=*|DISPLAY=*|XDG_RUNTIME_DIR=*|XDG_CURRENT_DESKTOP=*|\
            XDG_SESSION_TYPE=*|DESKTOP_SESSION=*|DBUS_SESSION_BUS_ADDRESS=*|\
            HYPRLAND_INSTANCE_SIGNATURE=*|SWAYSOCK=*|NIRI_SOCKET=*|MANGO_INSTANCE_SIGNATURE=*|QT_QPA_PLATFORM=*)
                export "${line?}"
                ;;
        esac
    done < "/proc/$pid/environ" || true

    return 0
}

start_shell_unless_idle() {
    if [[ "$AUTO_MODE" == 1 && "${1:-1}" == 0 ]]; then
        log_info 'Шелл не был запущен — не стартую.'
        return 0
    fi
    start_shell
}

auto_shell_step() {
    local mode="$1" failed notified

    if ! is_installed; then
        log_info 'Serpantinum не установлен — пропускаю (в фоне ничего не ставлю).'
        return 0
    fi

    REPO_BRANCH="$(auto_get AUTO_BRANCH "$REPO_BRANCH")"

    if ! ensure_repo; then
        log_warn 'Serpantinum: репозиторий недоступен — пропускаю.'
        return 0
    fi

    load_state
    init_compositor_detection

    OLD_COMMIT="$(get_installed_commit)"
    OLD_VERSION="$(get_installed_version)"
    TARGET_COMMIT="$(get_target_commit "$PROJECT_ROOT")"
    TARGET_VERSION="$(get_target_version "$PROJECT_ROOT")"

    if [[ "$TARGET_COMMIT" == unknown || "$OLD_COMMIT" == "$TARGET_COMMIT" ]]; then
        log_info "Serpantinum актуален ($OLD_VERSION, $OLD_COMMIT)."
        return 0
    fi

    log_info "Serpantinum: доступно $OLD_VERSION ($OLD_COMMIT) -> $TARGET_VERSION ($TARGET_COMMIT)"

    if [[ "$mode" == notify ]]; then
        notified="$(auto_get AUTO_NOTIFIED_COMMIT '')"
        if [[ "$notified" != "$TARGET_COMMIT" ]]; then
            auto_notify 'Serpantinum: есть обновление' "$OLD_VERSION → $TARGET_VERSION. Применить: linka update"
            auto_set AUTO_NOTIFIED_COMMIT "$TARGET_COMMIT"
        fi
        return 0
    fi

    failed="$(auto_get AUTO_FAILED_COMMIT '')"
    if [[ "$failed" == "$TARGET_COMMIT" ]]; then
        log_info "Прошлая попытка обновиться на $TARGET_COMMIT не удалась — не повторяю (linka update вручную)."
        return 0
    fi

    auto_adopt_session_env || log_info 'Окружение сессии не найдено; проверю возможность безопасного обновления.'
    auto_notify 'Serpantinum' "Обновляю: $OLD_VERSION → $TARGET_VERSION"

    if linka_run_reported update flow_update; then
        auto_set AUTO_FAILED_COMMIT ''
        auto_notify 'Serpantinum обновлён' "$TARGET_VERSION ($TARGET_COMMIT)"
    else
        auto_set AUTO_FAILED_COMMIT "$TARGET_COMMIT"
        auto_notify 'Serpantinum: обновление не удалось' "Подробности: $AUTO_LOG" critical
    fi

    return 0
}

auto_on_battery() {
    local d t online have_ac=0 have_bat=0

    for d in /sys/class/power_supply/*; do
        if [[ ! -r "$d/type" ]]; then
            continue
        fi
        t="$(cat "$d/type" 2>/dev/null || true)"
        case "$t" in
            Battery)
                have_bat=1
                ;;
            Mains)
                online="$(cat "$d/online" 2>/dev/null || echo 0)"
                if [[ "$online" == 1 ]]; then
                    have_ac=1
                fi
                ;;
        esac
    done

    [[ "$have_bat" == 1 && "$have_ac" == 0 ]]
}

auto_system_due() {
    local every last now
    every="$(auto_get AUTO_SYSTEM_EVERY_DAYS 1)"
    last="$(auto_get AUTO_LAST_SYSTEM 0)"
    now="$(date +%s)"

    [[ "$last" =~ ^[0-9]+$ ]] || last=0
    [[ "$every" =~ ^[0-9]+$ ]] || every=1

    (( now - 10#$last >= 10#$every * 86400 ))
}

sudoers_escape() {
    printf '%s' "$1" | sed -e 's/[,:=\\]/\\&/g'
}

auto_privileged_commands() {
    local mode="$1" bin

    if [[ "$mode" == off ]]; then
        return 0
    fi

    if [[ "$DISTRO" == fedora ]]; then
        if [[ "$mode" == apply ]]; then
            bin="$(command -v dnf 2>/dev/null || command -v dnf5 2>/dev/null || true)"
            if [[ -n "$bin" ]]; then
                printf '%s %s\n' "$bin" "${AUTO_DNF_APPLY[*]}"
            fi
        fi
    else
        bin="$(command -v emerge 2>/dev/null || true)"
        if [[ -n "$bin" ]]; then
            printf '%s %s\n' "$bin" "${AUTO_EMERGE_SYNC[*]}"
            printf '%s %s\n' "$bin" "${AUTO_EMERGE_PRETEND[*]}"
            if [[ "$mode" == apply ]]; then
                printf '%s %s\n' "$bin" "${AUTO_EMERGE_APPLY[*]}"
            fi
        fi
    fi

    return 0
}

auto_sudo_ok() {
    local mode="$1" line
    local -a words

    while IFS= read -r line; do
        if [[ -z "$line" ]]; then
            continue
        fi
        read -r -a words <<< "$line"
        if ! sudo -n -k -l "${words[@]}" >/dev/null 2>&1; then
            return 1
        fi
    done < <(auto_privileged_commands "$mode")

    return 0
}

auto_install_sudoers() {
    local mode="$1" user line tmp w
    local -a words esc
    local -a rules=()

    user="$(id -un)"

    while IFS= read -r line; do
        if [[ -z "$line" ]]; then
            continue
        fi
        read -r -a words <<< "$line"
        esc=()
        for w in "${words[@]}"; do
            esc+=("$(sudoers_escape "$w")")
        done
        rules+=("${esc[*]}")
    done < <(auto_privileged_commands "$mode")

    if [[ ${#rules[@]} -eq 0 ]]; then
        return 0
    fi

    local joined="" r
    for r in "${rules[@]}"; do
        joined+="${joined:+, }$r"
    done

    tmp="$(mktemp)"
    {
        printf '# Создано linka (linka auto enable). Удаляется командой: linka auto disable\n'
        printf '# Разрешает пользователю %s выполнять БЕЗ пароля только эти точные команды.\n' "$user"
        printf '%s ALL=(root) NOPASSWD: %s\n' "$user" "$joined"
    } > "$tmp"

    if command -v visudo >/dev/null 2>&1 && ! visudo -cf "$tmp" >/dev/null 2>&1; then
        log_error 'Сгенерированный sudoers не прошёл проверку visudo — не устанавливаю.'
        rm -f "$tmp"
        return 1
    fi

    run_root mkdir -p "$(dirname "$AUTO_SUDOERS_FILE")" 2>/dev/null || true

    if ! run_root install -m 0440 -o root -g root "$tmp" "$AUTO_SUDOERS_FILE"; then
        log_error "Не удалось установить $AUTO_SUDOERS_FILE"
        rm -f "$tmp"
        return 1
    fi

    rm -f "$tmp"

    if auto_sudo_ok "$mode"; then
        log_ok "Правило sudoers установлено: $AUTO_SUDOERS_FILE"
    else
        log_warn "Правило записано, но sudo всё ещё просит пароль. Проверьте, что /etc/sudoers подключает /etc/sudoers.d."
        return 1
    fi

    return 0
}

auto_reboot_hint() {
    local out bin
    bin="$(command -v dnf 2>/dev/null || command -v dnf5 2>/dev/null || true)"
    if [[ -z "$bin" ]]; then
        return 1
    fi
    out="$("$bin" needs-restarting -r 2>&1 || true)"
    grep -qi 'reboot is required' <<< "$out"
}

auto_system_fedora() {
    local mode="$1" rc=0 bin

    bin="$(command -v dnf 2>/dev/null || command -v dnf5 2>/dev/null || true)"
    if [[ -z "$bin" ]]; then
        log_warn 'Система: dnf не найден.'
        return 0
    fi

    "$bin" -q --refresh check-update >/dev/null 2>&1 || rc=$?

    case "$rc" in
        0)
            log_info 'Система: обновлений нет.'
            auto_set AUTO_LAST_SYSTEM "$(date +%s)"
            return 0
            ;;
        100)
            ;;
        *)
            log_warn "Система: dnf check-update завершился с кодом $rc."
            return 0
            ;;
    esac

    if [[ "$mode" == notify ]]; then
        log_info 'Система: есть обновления пакетов (режим notify).'
        auto_notify 'Обновления системы' 'Есть обновления пакетов. Применить: sudo dnf upgrade'
        auto_set AUTO_LAST_SYSTEM "$(date +%s)"
        return 0
    fi

    if ! auto_sudo_ok apply; then
        log_warn 'Система: sudo просит пароль. Выполните: linka auto enable --system apply'
        auto_notify 'Обновление системы не выполнено' 'sudo просит пароль: linka auto enable --system apply' critical
        return 0
    fi

    log_info 'Система: dnf upgrade...'
    if run_root "$bin" "${AUTO_DNF_APPLY[@]}"; then
        auto_set AUTO_LAST_SYSTEM "$(date +%s)"
        if auto_reboot_hint; then
            log_ok 'Система обновлена, нужна перезагрузка.'
            auto_notify 'Система обновлена' 'Нужна перезагрузка, чтобы применить обновления ядра/библиотек.'
        else
            log_ok 'Система обновлена.'
            auto_notify 'Система обновлена' 'Пакеты обновлены.'
        fi
    else
        log_warn 'Система: dnf upgrade завершился с ошибкой.'
        auto_notify 'Обновление системы не удалось' "Подробности: $AUTO_LOG" critical
    fi

    return 0
}

auto_system_gentoo() {
    local mode="$1" bin out="" n=0

    bin="$(command -v emerge 2>/dev/null || true)"
    if [[ -z "$bin" ]]; then
        log_warn 'Система: emerge не найден.'
        return 0
    fi

    if ! auto_sudo_ok "$mode"; then
        log_warn "Система: sudo просит пароль. Выполните: linka auto enable --system $mode"
        auto_notify 'Обновление системы не выполнено' "sudo просит пароль: linka auto enable --system $mode" critical
        return 0
    fi

    log_info 'Система: emerge --sync...'
    if ! run_root "$bin" "${AUTO_EMERGE_SYNC[@]}" >/dev/null 2>&1; then
        log_warn 'Система: emerge --sync не удался.'
        return 0
    fi

    out="$(run_root "$bin" "${AUTO_EMERGE_PRETEND[@]}" 2>&1 || true)"
    n="$(printf '%s\n' "$out" | grep -c '^\[ebuild' || true)"

    if [[ "$n" -eq 0 ]]; then
        log_info 'Система: обновлений нет.'
        auto_set AUTO_LAST_SYSTEM "$(date +%s)"
        return 0
    fi

    log_info "Система: пакетов к обновлению — $n."

    if printf '%s\n' "$out" | grep -q '^\[blocks'; then
        log_warn 'Система: emerge сообщает о блокировках — автоматически не обновляю.'
        auto_notify 'Обновления системы' "Пакетов к обновлению: $n, но есть блокировки — нужен ручной emerge." critical
        auto_set AUTO_LAST_SYSTEM "$(date +%s)"
        return 0
    fi

    if [[ "$mode" == notify ]]; then
        auto_notify 'Обновления системы' "Пакетов к обновлению: $n. Применить: emerge -uDN @world"
        auto_set AUTO_LAST_SYSTEM "$(date +%s)"
        return 0
    fi

    log_info 'Система: emerge @world (может занять часы)...'
    if run_root "$bin" "${AUTO_EMERGE_APPLY[@]}"; then
        auto_set AUTO_LAST_SYSTEM "$(date +%s)"
        log_ok 'Система обновлена.'
        auto_notify 'Система обновлена' "Обновлено пакетов: $n. Проверьте etc-update/dispatch-conf."
    else
        log_warn 'Система: emerge завершился с ошибкой.'
        auto_notify 'Обновление системы не удалось' "Подробности: $AUTO_LOG" critical
    fi

    return 0
}

auto_system_step() {
    local mode
    mode="$(auto_get AUTO_SYSTEM off)"

    if [[ "$mode" == off ]]; then
        return 0
    fi

    if ! auto_system_due; then
        log_info 'Система: ещё рано (AUTO_SYSTEM_EVERY_DAYS).'
        return 0
    fi

    if auto_on_battery; then
        log_info 'Система: работаю от батареи — пропускаю.'
        return 0
    fi

    if [[ "$DISTRO" == fedora ]]; then
        auto_system_fedora "$mode"
    else
        auto_system_gentoo "$mode"
    fi

    return 0
}

auto_run_body() {
    local t

    printf '=== %s | linka %s | auto run ===\n' "$(date '+%F %T')" "$LINKA_VERSION"

    for t in git curl; do
        if ! command -v "$t" >/dev/null 2>&1; then
            log_warn "Не найдено: $t — пропускаю."
            return 0
        fi
    done

    if ! auto_network_ok; then
        log_info 'Нет сети — пропускаю.'
        return 0
    fi

    local sm
    sm="$(auto_get AUTO_SHELL apply)"
    if [[ "$sm" != off ]]; then
        auto_shell_step "$sm" || true
    fi

    auto_system_step || true
    return 0
}

auto_run_once() {
    AUTO_MODE=1

    if ! acquire_lock_quiet; then
        log_info 'linka сейчас занята (другой терминал/обновление) — пропускаю.'
        return 0
    fi

    auto_run_body || true
    release_lock
    return 0
}

auto_run_cli() {
    local a verbose=0
    for a in "$@"; do
        case "$a" in
            -v|--verbose) verbose=1 ;;
        esac
    done

    AUTO_MODE=1
    if [[ "$verbose" != 1 ]]; then
        auto_setup_log
    fi

    auto_run_once
    return 0
}

auto_script_path() {
    readlink -f "${BASH_SOURCE[0]:-$0}"
}

auto_have_systemd_user() {
    [[ "$(detect_init_system)" == systemd ]] &&
        command -v systemctl >/dev/null 2>&1 &&
        systemctl --user show-environment >/dev/null 2>&1
}

auto_systemd_install() {
    local script="$1" minutes="$2"

    mkdir -p "$AUTO_UNIT_DIR"

    cat > "$AUTO_UNIT_DIR/linka-auto.service" <<EOF_SVC
[Unit]
Description=linka: фоновое обновление Serpantinum и системы

[Service]
Type=oneshot
ExecStart=/usr/bin/env bash "$script" auto run
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=infinity
KillMode=process
EOF_SVC

    cat > "$AUTO_UNIT_DIR/linka-auto.timer" <<EOF_TMR
[Unit]
Description=linka: периодическая проверка обновлений

[Timer]
OnActiveSec=10min
OnUnitActiveSec=${minutes}min
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
EOF_TMR

    systemctl --user daemon-reload || return 1
    systemctl --user enable --now linka-auto.timer || return 1
    return 0
}

auto_systemd_remove() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user disable --now linka-auto.timer >/dev/null 2>&1 || true
        systemctl --user stop linka-auto.service >/dev/null 2>&1 || true
    fi

    rm -f "$AUTO_UNIT_DIR/linka-auto.service" "$AUTO_UNIT_DIR/linka-auto.timer"

    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user daemon-reload >/dev/null 2>&1 || true
    fi
    return 0
}

auto_daemon_pid() {
    local pid=""
    if [[ -f "$AUTO_PID_FILE" ]]; then
        pid="$(cat "$AUTO_PID_FILE" 2>/dev/null || true)"
    fi

    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null &&
       grep -q 'daemon' "/proc/$pid/cmdline" 2>/dev/null; then
        printf '%s\n' "$pid"
    fi
    return 0
}

auto_daemon_start() {
    local script="$1"

    if [[ -n "$(auto_daemon_pid)" ]]; then
        return 0
    fi

    if command -v setsid >/dev/null 2>&1; then
        setsid -f bash "$script" auto daemon </dev/null >/dev/null 2>&1 || true
    else
        nohup bash "$script" auto daemon </dev/null >/dev/null 2>&1 &
        disown 2>/dev/null || true
    fi
    return 0
}

auto_daemon_stop() {
    local pid
    pid="$(auto_daemon_pid)"
    if [[ -n "$pid" ]]; then
        kill "$pid" 2>/dev/null || true
    fi
    rm -f "$AUTO_PID_FILE"
    return 0
}

auto_daemon() {
    local minutes secs

    if command -v flock >/dev/null 2>&1; then
        exec 8>"$AUTO_DAEMON_LOCK" || true
        if ! flock -n 8; then
            return 0
        fi
    fi

    mkdir -p "$STATE_DIR"
    printf '%s\n' "$$" > "$AUTO_PID_FILE"
    trap 'kill "${AUTO_SLEEP_PID:-0}" 2>/dev/null || true; rm -f "$AUTO_PID_FILE"; cleanup_terminal' EXIT

    sleep "${LINKA_AUTO_FIRST_DELAY:-300}" & AUTO_SLEEP_PID=$!
    wait "$AUTO_SLEEP_PID" || true

    while true; do
        ( auto_run_cli ) || true

        minutes="$(auto_get AUTO_INTERVAL_MIN 15)"
        [[ "$minutes" =~ ^[0-9]+$ ]] || minutes=15
        secs=$(( 10#$minutes * 60 ))

        sleep "${LINKA_AUTO_LOOP_SECS:-$secs}" & AUTO_SLEEP_PID=$!
        wait "$AUTO_SLEEP_PID" || true
    done
}

auto_status() {
    local sh sys mins days nt br last
    local script

    sh="$(auto_get AUTO_SHELL apply)"
    sys="$(auto_get AUTO_SYSTEM off)"
    mins="$(auto_get AUTO_INTERVAL_MIN 15)"
    days="$(auto_get AUTO_SYSTEM_EVERY_DAYS 1)"
    nt="$(auto_get AUTO_NOTIFY 1)"
    br="$(auto_get AUTO_BRANCH "$REPO_BRANCH")"
    last="$(auto_get AUTO_LAST_SYSTEM 0)"
    script="$(auto_script_path || true)"

    printf '%sАвтообновление linka%s\n' "$BOLD" "$RESET"

    if auto_have_systemd_user; then
        if systemctl --user is-enabled linka-auto.timer >/dev/null 2>&1; then
            printf '  планировщик:   systemd --user таймер (включён, %s)\n' \
                "$(systemctl --user is-active linka-auto.timer 2>/dev/null || true)"
            systemctl --user list-timers linka-auto.timer --no-pager 2>/dev/null | sed -n '1,2p' | sed 's/^/                 /' || true
        else
            printf '  планировщик:   выключен\n'
        fi
    else
        if [[ -n "$(auto_daemon_pid)" ]]; then
            printf '  планировщик:   демон (pid %s)\n' "$(auto_daemon_pid)"
        elif [[ -f "$AUTO_AUTOSTART_FILE" ]]; then
            printf '  планировщик:   автозапуск настроен, демон сейчас не работает\n'
        else
            printf '  планировщик:   выключен\n'
        fi
    fi

    printf '  Serpantinum:   %s (ветка %s)\n' "$sh" "$br"
    printf '  система:       %s (раз в %s дн.)\n' "$sys" "$days"
    printf '  проверка:      каждые %s мин.\n' "$mins"
    printf '  уведомления:   %s\n' "$([[ "$nt" == 1 ]] && printf да || printf нет)"

    if [[ "$last" =~ ^[0-9]+$ && "$last" -gt 0 ]]; then
        printf '  последнее обновление системы: %s\n' "$(date -d "@$last" '+%F %T' 2>/dev/null || printf '%s' "$last")"
    fi

    if [[ "$sys" != off ]]; then
        if auto_sudo_ok "$sys"; then
            printf '  sudo без пароля: есть\n'
        else
            printf '  sudo без пароля: НЕТ — linka auto enable --system %s\n' "$sys"
        fi
    fi

    if [[ -n "$script" && ! -f "$script" ]]; then
        printf '  ВНИМАНИЕ: файл скрипта не найден: %s\n' "$script"
    fi

    if [[ -f "$AUTO_LOG" ]]; then
        printf '\n  Журнал (%s):\n' "$AUTO_LOG"
        tail -n 6 "$AUTO_LOG" 2>/dev/null | sed 's/^/    /' || true
    fi

    return 0
}

auto_enable() {
    local shell_mode sys_mode minutes days notify branch prev_sys script

    shell_mode="$(auto_get AUTO_SHELL apply)"
    sys_mode="$(auto_get AUTO_SYSTEM off)"
    minutes="$(auto_get AUTO_INTERVAL_MIN 15)"
    days="$(auto_get AUTO_SYSTEM_EVERY_DAYS 1)"
    notify="$(auto_get AUTO_NOTIFY 1)"
    branch="$(auto_get AUTO_BRANCH "$REPO_BRANCH")"
    prev_sys="$sys_mode"

    if [[ -n "${SERPANTINUM_BRANCH:-}" ]]; then
        branch="$SERPANTINUM_BRANCH"
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --shell)      shell_mode="${2:-}"; shift 2 || shift ;;
            --system)     sys_mode="${2:-}"; shift 2 || shift ;;
            --interval)   minutes="${2:-}"; shift 2 || shift ;;
            --every-days) days="${2:-}"; shift 2 || shift ;;
            --branch)     branch="${2:-}"; shift 2 || shift ;;
            --no-notify)  notify=0; shift ;;
            --notify)     notify=1; shift ;;
            *)
                log_error "auto enable: неизвестный параметр: $1"
                usage
                return 1
                ;;
        esac
    done

    if ! auto_valid_mode "$shell_mode"; then
        log_error '--shell: apply | notify | off'
        return 1
    fi
    if ! auto_valid_mode "$sys_mode"; then
        log_error '--system: apply | notify | off'
        return 1
    fi
    if ! auto_valid_uint "$minutes"; then
        log_error '--interval: целое число минут > 0'
        return 1
    fi
    if ! auto_valid_uint "$days"; then
        log_error '--every-days: целое число дней > 0'
        return 1
    fi

    script="$(auto_script_path)"
    if [[ ! -f "$script" || "$script" == /dev/* || "$script" == /proc/* ]]; then
        log_error 'Не могу определить путь к linka: запустите её из файла (не через pipe/process substitution).'
        return 1
    fi
    case "$script" in
        /tmp/*|/var/tmp/*)
            log_warn "linka лежит в $script — временный каталог может очиститься, и автообновление перестанет работать."
            ;;
    esac

    local need_sudo=false
    if [[ -n "$(auto_privileged_commands "$sys_mode")" ]]; then
        need_sudo=true
    fi

    if [[ "$need_sudo" == true ]]; then
        start_sudo_keepalive
        if ! auto_install_sudoers "$sys_mode"; then
            run_optional_root rm -f "$AUTO_SUDOERS_FILE" || true
            log_warn 'Обновление системы отключено (не удалось настроить sudo). Остальное включится.'
            sys_mode=off
        fi
    elif [[ "$prev_sys" != off ]]; then
        start_sudo_keepalive
        run_optional_root rm -f "$AUTO_SUDOERS_FILE" || true
    fi

    auto_set AUTO_SHELL "$shell_mode"
    auto_set AUTO_SYSTEM "$sys_mode"
    auto_set AUTO_INTERVAL_MIN "$minutes"
    auto_set AUTO_SYSTEM_EVERY_DAYS "$days"
    auto_set AUTO_NOTIFY "$notify"
    auto_set AUTO_BRANCH "$branch"

    if auto_have_systemd_user; then
        auto_daemon_stop
        rm -f "$AUTO_AUTOSTART_FILE"
        if auto_systemd_install "$script" "$minutes"; then
            log_ok "Включено: systemd --user таймер linka-auto.timer (каждые ${minutes} мин., первый запуск через ~10 мин)."
        else
            log_error 'Не удалось включить systemd-таймер.'
            return 1
        fi
    else
        auto_systemd_remove
        mkdir -p "$(dirname "$AUTO_AUTOSTART_FILE")"
        cat > "$AUTO_AUTOSTART_FILE" <<EOF_DESK
[Desktop Entry]
Type=Application
Name=linka auto-update
Comment=Фоновое обновление Serpantinum
Exec=bash "$script" auto daemon
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF_DESK
        auto_daemon_stop
        auto_daemon_start "$script"
        log_ok "Включено: фоновый демон (каждые ${minutes} мин.), автозапуск: $AUTO_AUTOSTART_FILE"
        log_info 'Если композитор не читает XDG autostart — добавьте в его конфиг:  exec-once = linka auto daemon'
        log_info 'Для exec-once нужна команда linka в PATH: ln -s "'"$script"'" ~/.local/bin/linka'
    fi

    log_info "Serpantinum: $shell_mode | система: $sys_mode | журнал: $AUTO_LOG"
    return 0
}

auto_disable() {
    local quiet=false prev_sys
    if [[ "${1:-}" == --quiet ]]; then
        quiet=true
    fi

    prev_sys="$(auto_get AUTO_SYSTEM off)"

    auto_systemd_remove
    auto_daemon_stop
    rm -f "$AUTO_AUTOSTART_FILE"

    if [[ "$prev_sys" != off ]]; then
        start_sudo_keepalive
        run_optional_root rm -f "$AUTO_SUDOERS_FILE" || true
    fi

    rm -f "$AUTO_CONF"

    if [[ "$quiet" != true ]]; then
        log_ok 'Автообновление выключено.'
    fi
    return 0
}

auto_menu() {
    local c=''

    clear 2>/dev/null || true
    auto_status
    printf '\n  [e] включить (по умолчанию)   [d] выключить   [Enter] назад: '
    read -rn1 c || true
    printf '\n'

    case "$c" in
        e|E) auto_enable || true ;;
        d|D) auto_disable || true ;;
    esac
    return 0
}

auto_main() {
    local sub="${1:-status}"
    if [[ $# -gt 0 ]]; then
        shift
    fi

    case "$sub" in
        enable)  auto_enable "$@"; end_session ;;
        disable) auto_disable "$@"; end_session ;;
        status)  auto_status ;;
        run)     auto_run_cli "$@" ;;
        daemon)  auto_daemon ;;
        *)
            log_error "auto: неизвестная подкоманда: $sub"
            usage
            exit 1
            ;;
    esac
    return 0
}

linka_stage_shell() {
    local repo="$1" stage="$2" path parent part prefix old
    [[ -d "$TARGET_BASE" ]] || return 1
    if [[ -d "$TARGET_BASE" ]]; then
        cp -a --reflink=auto "$TARGET_BASE/." "$stage/" || return 1
    fi
    if [[ -n "$OLD_COMMIT" && "$OLD_COMMIT" != unknown ]] && git -C "$repo" cat-file -e "${OLD_COMMIT}^{commit}" 2>/dev/null; then
        while IFS= read -r -d '' old; do
            parent="${old%/*}"
            prefix="$stage"
            while [[ -n "$parent" ]]; do
                part="${parent%%/*}"
                [[ -n "$part" && "$part" != . && "$part" != .. && -d "$prefix/$part" && ! -L "$prefix/$part" ]] || break
                prefix="$prefix/$part"
                if [[ "$parent" == "$part" ]]; then
                    parent=""
                else
                    parent="${parent#*/}"
                fi
            done
            [[ -z "$parent" ]] || continue
            rm -rf -- "${stage:?}/$old" || return 1
        done < <(git -C "$repo" diff -z --name-only --no-renames --diff-filter=D "$OLD_COMMIT" HEAD -- bin src)
    fi
    while IFS= read -r -d '' path; do
        parent="${path%/*}"
        prefix="$stage"
        while IFS= read -r part; do
            [[ -n "$part" ]] || continue
            prefix="$prefix/$part"
            if [[ -L "$prefix" || ( -e "$prefix" && ! -d "$prefix" ) ]]; then
                rm -f -- "$prefix" || return 1
            fi
            mkdir -p -- "$prefix" || return 1
        done < <(tr '/' '\n' <<< "$parent")
        rm -rf -- "${stage:?}/$path" || return 1
        cp -a -- "$repo/$path" "$stage/$path" || return 1
    done < <(git -C "$repo" ls-files -z -- bin src)
    if [[ -f "$repo/version.txt" ]]; then
        cp -a --remove-destination -- "$repo/version.txt" "$stage/version.txt" || return 1
    fi
    if [[ ! -f "$stage/.serpantinum-managed" ]]; then
        printf 'owner=linka\nversion=%s\nrepo=%s\n' "$LINKA_VERSION" "$REPO_SLUG" > "$stage/.serpantinum-managed" || return 1
    fi
    (
        TARGET_BASE="$stage"
        fix_exec_bits
        verify_deploy "$repo"
    )
}

linka_journal_write() {
    local previous="$1" next="$2" backup="$3" was="$4" temp
    temp="$(mktemp "$STATE_DIR/.linka-journal.XXXXXXXX")" || return 1
    if ! printf '%s\n%s\n%s\n%s\n' "$previous" "$next" "$backup" "$was" > "$temp" ||
       ! mv -f -- "$temp" "$STATE_DIR/.linka-journal"; then
        rm -f -- "$temp"
        return 1
    fi
}

linka_switch_generation() {
    local next="$1" temp="$TARGET_BASE.linka-next.$$"
    [[ -d "$next" && ! -L "$next" ]] || return 1
    ln -s -- "$next" "$temp" || return 1
    if [[ -d "$TARGET_BASE" && ! -L "$TARGET_BASE" ]]; then
        rm -f -- "$temp"
        return 1
    fi
    if ! mv -fT -- "$temp" "$TARGET_BASE"; then
        rm -f -- "$temp"
        return 1
    fi
}

restore_update_state() {
    [[ -n "$UPDATE_BACKUP_DIR" && -f "$UPDATE_BACKUP_DIR/.complete" ]] || return 1
    restore_snapshot_tree "$UPDATE_BACKUP_DIR/state" "$STATE_DIR"
}

linka_restore_transaction() {
    local previous="$1" was="$2" failed=0
    if [[ -d "$previous" ]]; then
        stop_shell || true
        linka_switch_generation "$previous" || failed=1
    elif [[ ! -d "$TARGET_BASE" ]]; then
        failed=1
    fi
    restore_update_config || failed=1
    restore_update_sounds || failed=1
    restore_update_state || failed=1
    if [[ "$was" == 1 ]]; then
        start_shell_unless_idle 1 || failed=1
    fi
    if [[ "$failed" -eq 0 ]]; then
        rm -f -- "$STATE_DIR/.linka-journal"
        log_warn 'Предыдущее поколение Serpantinum и настройки восстановлены.'
        return 0
    fi
    log_error "Автоматическое восстановление не завершено. Журнал: $STATE_DIR/.linka-journal"
    return 1
}

linka_recover_transaction() {
    local journal="$STATE_DIR/.linka-journal" previous next backup was
    [[ -f "$journal" ]] || return 0
    mapfile -t _linka_journal < "$journal"
    previous="${_linka_journal[0]:-}"
    next="${_linka_journal[1]:-}"
    backup="${_linka_journal[2]:-}"
    was="${_linka_journal[3]:-0}"
    [[ "$(realpath -m -- "$previous")" == "$GENERATIONS_BASE"/* &&
       "$(realpath -m -- "$next")" == "$GENERATIONS_BASE"/* &&
       "$(realpath -m -- "$backup")" == "$BACKUP_BASE"/* ]] || return 1
    UPDATE_BACKUP_DIR="$backup"
    linka_restore_transaction "$previous" "$was"
}

linka_health_check() {
    local generation="$1" i
    for i in 1 2 3 4 5; do
        sleep 1
        pgrep -f "$generation/src/quickshell" >/dev/null 2>&1 || return 1
    done
    return 0
}

linka_prune_generations() {
    local current="$1" previous="$2" path
    while IFS= read -r -d '' path; do
        [[ "$path" == "$current" || "$path" == "$previous" ]] && continue
        rm -rf -- "$path" || return 1
    done < <(find "$GENERATIONS_BASE" -mindepth 1 -maxdepth 1 -type d -print0)
}

linka_update_session_ready() {
    auto_adopt_session_env || true
    if [[ -z "${WAYLAND_DISPLAY:-}" || -z "${XDG_RUNTIME_DIR:-}" || ! -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]]; then
        log_error 'Для безопасного обновления нужна активная графическая сессия Wayland. Повторите linka update из неё.'
        return 1
    fi
}

transactional_deploy_update() {
    local repo="$1" next previous was=0
    mkdir -p "$GENERATIONS_BASE" || return 1
    next="$(mktemp -d "$GENERATIONS_BASE/generation.XXXXXXXX")" || return 1
    if ! linka_stage_shell "$repo" "$next"; then
        rm -rf -- "$next"
        return 1
    fi
    backup_update_state || { rm -rf -- "$next"; return 1; }
    if ! (TARGET_DIR="$next" TARGET_BASE="$next"; fix_matugen_compat && run_user_post_update_hook); then
        restore_update_config || log_error 'Настройки после ошибки хука не восстановлены.'
        restore_update_sounds || log_error 'Звуки после ошибки хука не восстановлены.'
        restore_update_state || log_error 'Состояние после ошибки хука не восстановлено.'
        rm -rf -- "$next"
        return 1
    fi
    if shell_running; then was=1; fi
    if [[ -L "$TARGET_BASE" ]]; then
        previous="$(readlink -f -- "$TARGET_BASE")" || return 1
    else
        previous="$(mktemp -d "$GENERATIONS_BASE/previous.XXXXXXXX")" || return 1
        rmdir -- "$previous" || return 1
    fi
    linka_journal_write "$previous" "$next" "$UPDATE_BACKUP_DIR" "$was" || return 1
    if [[ "$was" == 1 ]] && ! stop_shell; then
        rm -f -- "$STATE_DIR/.linka-journal"
        log_error 'Оболочка не остановилась; переключение отменено.'
        return 1
    fi
    if [[ ! -L "$TARGET_BASE" ]]; then
        if ! mv -- "$TARGET_BASE" "$previous" || ! ln -s -- "$previous" "$TARGET_BASE"; then
            linka_restore_transaction "$previous" "$was" || true
            return 1
        fi
    fi
    if ! linka_switch_generation "$next"; then
        linka_restore_transaction "$previous" "$was" || true
        return 1
    fi
    if ! sync_sounds_from_repo "$repo" ||
       ! merge_serpantinum_config "$repo" ||
       ! start_shell ||
       ! linka_health_check "$next" ||
       ! mark_shell_state ||
       ! write_version_file; then
        linka_restore_transaction "$previous" "$was" || true
        return 1
    fi
    if [[ "$was" == 0 ]]; then
        stop_shell || log_warn 'Проверочная оболочка продолжает работать.'
    fi
    printf '%s\n%s\n' "$previous" "$UPDATE_BACKUP_DIR" > "$STATE_DIR/.linka-rollback" || return 1
    rm -f -- "$STATE_DIR/.linka-journal"
    linka_prune_generations "$next" "$previous" || log_warn 'Не удалось удалить старые поколения оболочки.'
    log_ok "Обновлён: $TARGET_VERSION ($TARGET_COMMIT)."
    return 0
}

linka_rollback() {
    local record="$STATE_DIR/.linka-rollback" previous backup current was=0
    [[ -f "$record" ]] || { log_error 'Нет сохранённого поколения для отката.'; return 1; }
    mapfile -t _linka_rollback < "$record"
    previous="${_linka_rollback[0]:-}"
    backup="${_linka_rollback[1]:-}"
    [[ "$(realpath -m -- "$previous")" == "$GENERATIONS_BASE"/* && -d "$previous" &&
       "$(realpath -m -- "$backup")" == "$BACKUP_BASE"/* && -f "$backup/.complete" ]] || return 1
    [[ -L "$TARGET_BASE" ]] || return 1
    current="$(readlink -f -- "$TARGET_BASE")" || return 1
    UPDATE_BACKUP_DIR="$backup"
    if shell_running; then was=1; fi
    linka_journal_write "$previous" "$current" "$backup" "$was" || return 1
    if [[ "$was" == 1 ]]; then stop_shell || return 1; fi
    if ! linka_switch_generation "$previous" ||
       ! restore_update_config || ! restore_update_sounds || ! restore_update_state ||
       { [[ "$was" == 1 ]] && ! start_shell_unless_idle 1; }; then
        log_error "Откат не завершён. Сохранён журнал: $STATE_DIR/.linka-journal"
        return 1
    fi
    rm -f -- "$STATE_DIR/.linka-journal" "$record"
    linka_prune_generations "$previous" "$previous" || log_warn 'Не удалось удалить отменённое поколение.'
    log_ok 'Файлы оболочки и настройки восстановлены. Пакеты ОС не изменялись.'
}

linka_doctor() {
    local pkg comp version failed=0 installed_flag=0
    local comps=()
    if [[ -f "$STATE_FILE" ]]; then
        local saved
        saved="$(state_get SELECTED_COMPOSITORS)"
        read -r -a comps <<< "$saved"
    fi
    printf 'linka %s · диагностика\n' "$LINKA_VERSION"
    printf 'Система: %s\n' "${DISTRO:-не определена}"
    if [[ -L "$TARGET_BASE" ]]; then
        printf 'Поколение: %s\n' "$(readlink -f -- "$TARGET_BASE")"
        installed_flag=1
    elif [[ -d "$TARGET_BASE" ]]; then
        printf 'Установка: обычный каталог\n'
        installed_flag=1
    else
        printf 'Установка: отсутствует\n'
    fi
    if [[ -f "$STATE_DIR/.linka-journal" ]]; then
        printf 'Восстановление: есть незавершённая операция\n'
        failed=1
    fi
    if [[ -f "$STATE_DIR/.linka-rollback" ]]; then
        printf 'Откат: доступен\n'
    fi
    for pkg in "${CORE_PKGS[@]}"; do
        if pkg_installed "$pkg"; then
            printf 'Пакет %s: установлен\n' "$pkg"
        else
            printf 'Пакет %s: отсутствует\n' "$pkg"
            failed=1
        fi
    done
    if command -v quickshell >/dev/null 2>&1; then
        version="$(quickshell_version)"
        if [[ -n "$version" ]] && version_ge "$version" "$QUICKSHELL_MIN_VERSION"; then
            printf 'Quickshell: %s\n' "$version"
        else
            printf 'Quickshell: несовместимая или неизвестная версия\n'
            failed=1
        fi
    else
        printf 'Quickshell: отсутствует\n'
        failed=1
    fi
    for comp in "${comps[@]}"; do
        if is_compositor_installed "$comp"; then
            printf 'Композитор %s: установлен\n' "$comp"
        else
            printf 'Композитор %s: отсутствует\n' "$comp"
            failed=1
        fi
    done
    if [[ "$installed_flag" == 1 ]]; then
        printf 'Коммит: %s\n' "$(state_get SHELL_COMMIT)"
    fi
    printf 'Бэкапы: %s\n' "$BACKUP_BASE"
    return "$failed"
}

linka_dry_run() {
    local operation="$1" target='неизвестен'
    if [[ -d "$CACHE_BASE/.git" ]]; then
        target="$(git -C "$CACHE_BASE" rev-parse --short HEAD 2>/dev/null || printf 'неизвестен')"
    fi
    printf 'Предпросмотр: %s\n' "$operation"
    printf 'Текущий коммит: %s\n' "$(state_get SHELL_COMMIT)"
    printf 'Доступный коммит в локальном кэше: %s\n' "$target"
    case "$operation" in
        install|reinstall)
            printf 'Шаги: проверка зависимостей → бэкап → подготовка файлов → настройка → запуск\n'
            ;;
        update)
            printf 'Шаги: проверка сессии и зависимостей → подготовка поколения → бэкап → переключение → проверка запуска\n'
            ;;
        rollback)
            printf 'Шаги: остановка оболочки → прежнее поколение → восстановление настроек → запуск\n'
            ;;
        remove)
            printf 'Шаги: бэкап настроек → остановка → удаление управляемых файлов и служб\n'
            ;;
    esac
    linka_doctor || true
    printf 'Изменений не внесено.\n'
}

linka_operation_summary() {
    local operation="$1" status="$2" label backup='нет' journal='нет'
    case "$operation" in
        install) label='Установка' ;;
        reinstall) label='Переустановка' ;;
        update) label='Обновление' ;;
        rollback) label='Откат' ;;
        remove) label='Удаление' ;;
        *) label="$operation" ;;
    esac
    if [[ "$status" == 0 ]]; then
        printf '%s: завершено\n' "$label"
        printf 'Пропущено: нет обязательных шагов\n'
    else
        printf '%s: ошибка (код %s)\n' "$label" "$status"
        printf 'Пропущено: оставшиеся шаги операции\n'
    fi
    if [[ -n "${UPDATE_BACKUP_DIR:-}" && -d "$UPDATE_BACKUP_DIR" ]]; then
        backup="$UPDATE_BACKUP_DIR"
    elif [[ -f "$STATE_DIR/.last-update-backup" ]]; then
        backup="$(cat "$STATE_DIR/.last-update-backup")"
    fi
    if [[ -f "$STATE_DIR/.linka-journal" ]]; then
        journal="$STATE_DIR/.linka-journal"
    fi
    printf 'Бэкап: %s\nЖурнал: %s\n' "$backup" "$journal"
    if [[ ${#FAILED_PKGS[@]} -gt 0 ]]; then
        printf 'Проблемы с пакетами: %s\n' "${FAILED_PKGS[*]}"
    fi
}

linka_run_reported() {
    local operation="$1" status=0
    shift
    "$@" || status=$?
    linka_operation_summary "$operation" "$status"
    return "$status"
}

main() {
    local operation="${1:-}" arg
    case "$operation" in
        install|--install) operation=install ;;
        reinstall|--reinstall) operation=reinstall ;;
        update|--update) operation=update ;;
        remove|--remove|uninstall|--uninstall) operation=remove ;;
        rollback) ;;
    esac
    case "$operation" in
        install|reinstall|update|remove|rollback)
            for arg in "${@:2}"; do
                if [[ "$arg" == --dry-run ]]; then
                    linka_dry_run "$operation"
                    return $?
                fi
            done
            ;;
    esac
    case "${1:-}" in
        -h|--help)
            usage
            ;;
        install|--install)
            shift
            prepare_environment
            linka_run_reported install flow_install install "$@"
            ;;
        reinstall|--reinstall)
            shift
            prepare_environment
            linka_run_reported reinstall flow_install reinstall "$@"
            ;;
        update|--update)
            if [[ "${2:-}" == "--force" || "${2:-}" == "-f" ]]; then
                FORCE_UPDATE=1
            fi

            prepare_environment
            linka_run_reported update flow_update
            ;;
        rollback)
            acquire_lock
            linka_recover_transaction || return 1
            linka_run_reported rollback linka_rollback
            end_session
            ;;
        doctor)
            linka_doctor
            ;;
        remove|--remove|uninstall|--uninstall)
            emergency_remove
            ;;
        kill|--kill)
            kill_serpantinum
            ;;
        auto|--auto)
            shift
            auto_main "$@"
            ;;
        '')
            linka_main_menu
            ;;
        *)
            log_error "Неизвестный аргумент: $1"
            usage
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    case "${1:-}" in
        -h|--help) ;;
        *) preflight ;;
    esac

    main "$@"
fi
