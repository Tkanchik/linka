gentoo_mango_release_atom() {
    command -v portageq >/dev/null 2>&1 || return 1

    local repo path ebuild version best=''
    for repo in $(portageq get_repos / 2>/dev/null); do
        path="$(portageq get_repo_path / "$repo" 2>/dev/null || true)"
        [[ -n "$path" ]] || continue
        for ebuild in "$path"/gui-wm/mangowm/mangowm-[0-9]*.ebuild; do
            [[ -f "$ebuild" ]] || continue
            version="${ebuild##*/mangowm-}"
            version="${version%.ebuild}"
            [[ "$version" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?(-r[0-9]+)?$ ]] || continue
            if version_ge "$version" 0.18 && { [[ -z "$best" ]] || version_ge "$version" "$best"; }; then
                best="$version"
            fi
        done
    done

    [[ -n "$best" ]] || return 1
    printf '=gui-wm/mangowm-%s\n' "$best"
}

gentoo_filter_atoms() {
    if [[ $# -eq 0 ]]; then
        return 0
    fi

    local repo_paths=() out=() miss=()
    local r rp atom c p found clean_atom

    if command -v portageq >/dev/null 2>&1; then
        for r in $(portageq get_repos / 2>/dev/null || true); do
            rp="$(portageq get_repo_path / "$r" 2>/dev/null || true)"
            if [[ -n "$rp" ]]; then
                repo_paths+=("$rp")
            fi
        done
    fi

    if [[ ${#repo_paths[@]} -eq 0 ]]; then
        printf '%s\n' "$@"
        return 0
    fi

    for atom in "$@"; do
        clean_atom="${atom#[><=~]}"
        c="${clean_atom%%/*}"
        p="${clean_atom##*/}"
        p="${p%%:*}"
        p="${p%%-[0-9]*}"
        found=0

        for rp in "${repo_paths[@]}"; do
            if [[ -d "$rp/$c/$p" ]]; then
                found=1
                break
            fi
        done

        if [[ "$found" -eq 1 ]]; then
            out+=("$atom")
        else
            miss+=("$atom")
        fi
    done

    if [[ ${#miss[@]} -gt 0 ]]; then
        log_warn "Gentoo: атомы не найдены в репозиториях и пропущены: ${miss[*]}"
    fi

    if [[ ${#out[@]} -gt 0 ]]; then
        printf '%s\n' "${out[@]}"
    elif [[ $# -gt 0 ]]; then
        printf '%s\n' "$@"
    fi

    return 0
}

gentoo_apply_autounmask_cfg() {
    local cfg_file target_file base name temp size
    for cfg_file in "$@"; do
        [[ -f "$cfg_file" && ! -L "$cfg_file" ]] || return 1
        base="${cfg_file##*/}"
        [[ "$base" =~ ^\._cfg[0-9]+_(.+)$ ]] || return 1
        name="${BASH_REMATCH[1]}"
        target_file="${cfg_file%/*}/$name"
        [[ ! -L "$target_file" ]] || return 1
        if [[ -f "$target_file" ]]; then
            size="$(run_root stat -c %s -- "$cfg_file")" || return 1
            if [[ "$size" -gt 0 ]] && run_root tail -c "$size" -- "$target_file" | run_root cmp -s -- "$cfg_file" -; then
                run_root rm -f -- "$cfg_file" || return 1
                continue
            fi
            temp="$(run_root mktemp "${target_file}.linka.XXXXXXXX")" || return 1
            if ! run_root cp -a -- "$target_file" "$temp" ||
               ! run_root cat -- "$cfg_file" | run_root tee -a -- "$temp" >/dev/null ||
               ! run_root mv -fT -- "$temp" "$target_file"; then
                run_root rm -f -- "$temp" || true
                log_error "Не удалось применить $cfg_file; исходник сохранён."
                return 1
            fi
            run_root rm -f -- "$cfg_file" || return 1
        else
            run_root mv -- "$cfg_file" "$target_file" || return 1
        fi
    done
    return 0
}

gentoo_pending_autounmask_cfg() {
    local root="${PORTAGE_ROOT:-/etc/portage}"
    find "$root" -maxdepth 2 -type f -name '._cfg[0-9]*_*' -print0 2>/dev/null | sort -z
}

gentoo_autounmask_resolve() {
    local round_i before after cfg
    local created=()

    if [[ $# -eq 0 ]]; then
        return 0
    fi

    for round_i in 1 2 3 4 5; do
        if emerge --pretend "$@" >/dev/null 2>&1; then
            return 0
        fi

        log_info "Gentoo: autounmask (круг $round_i)..."
        before="$(mktemp)" || return 1
        after="$(mktemp)" || { rm -f "$before"; return 1; }
        gentoo_pending_autounmask_cfg > "$before"
        run_root emerge --pretend --autounmask=y --autounmask-write=y "$@" >/dev/null 2>&1 || true
        gentoo_pending_autounmask_cfg > "$after"
        created=()
        while IFS= read -r -d '' cfg; do
            created+=("$cfg")
        done < <(comm -z -13 "$before" "$after")
        rm -f "$before" "$after"
        if [[ ${#created[@]} -eq 0 ]]; then
            log_error 'Gentoo: autounmask не создал новых изменений; старые файлы оставлены без изменений.'
            return 1
        fi
        gentoo_apply_autounmask_cfg "${created[@]}" || return 1
    done

    if emerge --pretend "$@" >/dev/null 2>&1; then
        return 0
    fi

    return 1
}

fedora_ensure_copr_plugin() {
    local dnf_cmd="dnf"
    if ! command -v dnf >/dev/null 2>&1 && command -v dnf5 >/dev/null 2>&1; then
        dnf_cmd="dnf5"
    fi

    if "$dnf_cmd" copr --help >/dev/null 2>&1; then
        return 0
    fi

    log_info 'Fedora: ставлю плагин dnf copr...'

    local plugin_pkg="dnf-plugins-core"
    if "$dnf_cmd" --version 2>/dev/null | grep -q -E '^(dnf5|5\.)'; then
        plugin_pkg="dnf5-plugins"
    fi

    run_root "$dnf_cmd" install -y "$plugin_pkg" >/dev/null 2>&1 ||
        run_root "$dnf_cmd" install -y dnf-plugins-core >/dev/null 2>&1 ||
        return 1

    "$dnf_cmd" copr --help >/dev/null 2>&1
}

fedora_enable_copr() {
    local repo="$1"
    local dnf_cmd="dnf"
    if ! command -v dnf >/dev/null 2>&1 && command -v dnf5 >/dev/null 2>&1; then
        dnf_cmd="dnf5"
    fi

    fedora_ensure_copr_plugin || return 1
    run_root "$dnf_cmd" copr enable -y "$repo"
}

fedora_enable_terra() {
    if rpm -q terra-release >/dev/null 2>&1; then
        return 0
    fi

    log_info 'Fedora: подключаю репозиторий Terra для MangoWM...'
    run_root dnf install -y --nogpgcheck --repofrompath \
        'terra,https://repos.fyralabs.com/terra$releasever' terra-release
}

find_serpantinumd() {
    local cand

    cand="$(command -v serpantinumd 2>/dev/null || true)"
    if [[ -n "$cand" && -x "$cand" ]]; then
        printf '%s\n' "$cand"
        return 0
    fi

    for cand in "$BIN_DIR/serpantinumd" "$TARGET_BASE/bin/serpantinumd"; do
        if [[ -x "$cand" ]]; then
            printf '%s\n' "$cand"
            return 0
        fi
    done

    return 1
}

run_serpantinumd() {
    local bin="$1"
    shift
    env -u SERPANTINUM_DIR -u QS_DIR -u MAIN_QML "$bin" "$@" 9>&- 8>&-
}

shell_running() {
    if pgrep -f "$TARGET_BASE/src/quickshell" >/dev/null 2>&1; then
        return 0
    fi

    if pgrep -f "$GENERATIONS_BASE/.*/src/quickshell" >/dev/null 2>&1; then
        return 0
    fi

    if pgrep -x serpantinumd >/dev/null 2>&1; then
        return 0
    fi

    if pgrep -f "$TARGET_BASE/bin/serpantinumd" >/dev/null 2>&1; then
        return 0
    fi

    if pgrep -f "bin/serpantinumd" >/dev/null 2>&1; then
        return 0
    fi

    if [[ -f "/tmp/serpantinumd.pid" ]]; then
        local p
        p="$(cat /tmp/serpantinumd.pid 2>/dev/null || true)"
        if [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null; then
            return 0
        fi
    fi

    return 1
}

stop_shell() {
    if ! shell_running; then
        return 0
    fi

    local bin i
    bin="$(find_serpantinumd || true)"

    if [[ -n "$bin" ]]; then
        if command -v timeout >/dev/null 2>&1; then
            timeout 5 env -u SERPANTINUM_DIR -u QS_DIR -u MAIN_QML "$bin" stop >/dev/null 2>&1 || true
        else
            run_serpantinumd "$bin" stop >/dev/null 2>&1 || true
        fi
    fi

    for i in 1 2 3 4 5; do
        if ! shell_running; then
            rm -f "/tmp/serpantinumd.pid" "/tmp/serpantinumd.lock" 2>/dev/null || true
            return 0
        fi
        sleep 1
    done

    pkill -f "$TARGET_BASE/src/quickshell" 2>/dev/null || true
    pkill -f "$GENERATIONS_BASE/.*/src/quickshell" 2>/dev/null || true
    pkill -x serpantinumd 2>/dev/null || true
    pkill -f "$TARGET_BASE/bin/serpantinumd" 2>/dev/null || true
    pkill -f "$BIN_DIR/serpantinumd" 2>/dev/null || true

    for i in 1 2 3; do
        if ! shell_running; then
            rm -f "/tmp/serpantinumd.pid" "/tmp/serpantinumd.lock" 2>/dev/null || true
            return 0
        fi
        sleep 1
    done

    pkill -9 -f "$TARGET_BASE/src/quickshell" 2>/dev/null || true
    pkill -9 -f "$GENERATIONS_BASE/.*/src/quickshell" 2>/dev/null || true
    pkill -9 -x serpantinumd 2>/dev/null || true
    pkill -9 -f "$TARGET_BASE/bin/serpantinumd" 2>/dev/null || true
    pkill -9 -f "$BIN_DIR/serpantinumd" 2>/dev/null || true

    for i in 1 2 3; do
        if ! shell_running; then
            rm -f "/tmp/serpantinumd.pid" "/tmp/serpantinumd.lock" 2>/dev/null || true
            return 0
        fi
        sleep 1
    done

    return 1
}

start_shell() {
    fc-cache -f >/dev/null 2>&1 || true
    export PATH="$BIN_DIR:$PATH"

    if [[ -z "${WAYLAND_DISPLAY:-}" || -z "${XDG_RUNTIME_DIR:-}" ]]; then
        auto_adopt_session_env || true
    fi

    local bin
    bin="$(find_serpantinumd || true)"

    if [[ -z "$bin" ]]; then
        log_warn 'serpantinumd не найден'
        return 1
    fi

    local started=0
    if command -v systemd-run >/dev/null 2>&1 && systemctl --user list-units >/dev/null 2>&1; then
        local env_args=()
        local v
        for v in WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR XDG_CURRENT_DESKTOP XDG_SESSION_TYPE \
                 DESKTOP_SESSION DBUS_SESSION_BUS_ADDRESS HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK \
                 NIRI_SOCKET MANGO_INSTANCE_SIGNATURE QT_QPA_PLATFORM PATH; do
            if [[ -n "${!v:-}" ]]; then
                env_args+=(--setenv="$v=${!v}")
            fi
        done
        if systemd-run --user --collect --slice=app.slice "${env_args[@]}" \
            env -u SERPANTINUM_DIR -u QS_DIR -u MAIN_QML "$bin" start </dev/null >/dev/null 2>&1; then
            started=1
        fi
    fi

    if [[ "$started" -ne 1 ]]; then
        if command -v setsid >/dev/null 2>&1; then
            setsid env -u SERPANTINUM_DIR -u QS_DIR -u MAIN_QML "$bin" start </dev/null >/dev/null 2>&1 9>&- 8>&- &
        else
            nohup env -u SERPANTINUM_DIR -u QS_DIR -u MAIN_QML "$bin" start </dev/null >/dev/null 2>&1 9>&- 8>&- &
        fi
        local d_pid=$!
        disown "$d_pid" 2>/dev/null || true
    fi

    local i
    for i in {1..10}; do
        if shell_running; then
            return 0
        fi
        sleep 0.5
    done

    log_warn "serpantinumd запущен, но статус shell пока не подтверждён ($bin)"
    return 1
}

kill_serpantinum() {
    log_info 'Остановка Serpantinum...'

    stop_shell || true

    pkill -9 -f "$TARGET_BASE/src/quickshell" 2>/dev/null || true
    pkill -9 -x serpantinumd 2>/dev/null || true
    pkill -9 -f "$TARGET_BASE/bin/serpantinumd" 2>/dev/null || true
    pkill -9 -f "$BIN_DIR/serpantinumd" 2>/dev/null || true

    sleep 1

    if shell_running; then
        log_warn 'Часть процессов жива'
        return 1
    fi

    log_ok 'Остановлено.'
    return 0
}

is_sddm_theme_managed() {
    [[ ! -e "$SDDM_THEME_DIR" ]] && return 0
    [[ -f "$SDDM_THEME_DIR/.linka-managed" ]] && return 0
    [[ -f "$SDDM_MANAGED_CONF" ]] && return 0
    return 1
}

is_font_system_managed() {
    [[ -L "$FONT_SYSTEM_DIR" ]] && return 1
    [[ ! -e "$FONT_SYSTEM_DIR" ]] && return 0
    [[ -f "$FONT_SYSTEM_DIR/.linka-managed" ]]
}

install_fonts() {
    local target="$USER_FONT_DIR"
    local cache zip
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/serpantinum-fonts"
    zip="$cache/Iosevka.zip"

    mkdir -p "$target"

    if ! compgen -G "$target/*.ttf" >/dev/null 2>&1; then
        if command -v curl >/dev/null 2>&1 && command -v unzip >/dev/null 2>&1; then
            log_info 'Шрифты Iosevka (может занять минуту на слабом канале)...'
            mkdir -p "$cache"

            if curl -fL --connect-timeout 15 --retry 3 "$FONT_URL" -o "$zip"; then
                local sha_file="$cache/SHA-256.txt"
                local expected_sha actual_sha
                if curl -fsSL --connect-timeout 10 "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/SHA-256.txt" -o "$sha_file" 2>/dev/null; then
                    expected_sha="$(grep -i 'Iosevka.zip$' "$sha_file" 2>/dev/null | awk '{print $1}' | head -n1)"
                    if [[ -n "$expected_sha" ]] && command -v sha256sum >/dev/null 2>&1; then
                        actual_sha="$(sha256sum "$zip" | awk '{print $1}')"
                        if [[ "$expected_sha" != "$actual_sha" ]]; then
                            log_error "Контрольная сумма шрифтов не совпадает (ожидалась: $expected_sha, получена: $actual_sha). Загрузка отменена."
                            rm -rf "$cache"
                            return 1
                        fi
                        log_info "Контрольная сумма Iosevka.zip проверена ($expected_sha)."
                    fi
                else
                    log_warn 'Не удалось скачать контрольные суммы SHA-256.txt, продолжаю без сверки хеша.'
                fi

                if unzip -qo "$zip" -d "$cache/x"; then
                    find "$cache/x" -type f -iname '*.ttf' ! -iname '*Mono*.ttf' -exec cp -f {} "$target/" \;
                    touch "$target/.linka-managed" 2>/dev/null || true
                else
                    log_warn 'Шрифты: не удалось распаковать'
                fi
            else
                log_warn 'Шрифты: не удалось скачать'
            fi
        else
            log_warn 'Шрифты: нет curl/unzip, пропускаю загрузку'
        fi

        rm -rf "$cache"
    fi

    fc-cache -f "$HOME/.local/share/fonts" >/dev/null 2>&1 || true

    if compgen -G "$target/*.ttf" >/dev/null 2>&1; then
        if [[ -d "$FONT_SYSTEM_DIR" ]] && ! is_font_system_managed; then
            log_warn "Каталог системных шрифтов $FONT_SYSTEM_DIR не управляется linka. Пропускаю установку системных шрифтов."
        else
            run_optional_root mkdir -p "$FONT_SYSTEM_DIR" || true
            run_optional_root cp -f "$target"/*.ttf "$FONT_SYSTEM_DIR/" || true
            run_optional_root touch "$FONT_SYSTEM_DIR/.linka-managed" 2>/dev/null || true
            run_optional_root fc-cache -f /usr/share/fonts >/dev/null 2>&1 || true
        fi
    fi

    return 0
}

setup_services() {
    local is
    is="$(detect_init_system)"

    if [[ "$is" == systemd ]]; then
        run_root systemctl --global enable pipewire wireplumber pipewire-pulse || true
        systemctl --user start pipewire wireplumber pipewire-pulse || true
        if systemctl --user list-unit-files easyeffects.service 2>/dev/null | grep -q -E '^easyeffects\.service([[:space:]]|$)'; then
            systemctl --user enable --now easyeffects.service || true
        fi
        run_root systemctl enable --now NetworkManager.service || true
        if systemctl list-unit-files power-profiles-daemon.service 2>/dev/null | grep -q -E '^power-profiles-daemon\.service([[:space:]]|$)'; then
            run_root systemctl enable --now power-profiles-daemon.service || true
        fi
        if systemctl list-unit-files tuned.service 2>/dev/null | grep -q -E '^tuned\.service([[:space:]]|$)'; then
            run_root systemctl enable --now tuned.service || true
        fi
    elif [[ "$is" == openrc ]]; then
        run_optional_root rc-update add NetworkManager default || true
        run_optional_root rc-service NetworkManager start || true
        if [[ -f /etc/init.d/power-profiles-daemon ]]; then
            run_optional_root rc-update add power-profiles-daemon default || true
            run_optional_root rc-service power-profiles-daemon start || true
        fi
        if [[ -f /etc/init.d/tuned ]]; then
            run_optional_root rc-update add tuned default || true
            run_optional_root rc-service tuned start || true
        fi
    fi

    return 0
}

get_wallpaper_dir() {
    local u=''

    if [[ -f "$HOME/.config/user-dirs.dirs" ]]; then
        u="$(sed -n 's/^XDG_PICTURES_DIR="\(.*\)"/\1/p' "$HOME/.config/user-dirs.dirs" | head -n1)"
        u="${u//\$HOME/$HOME}"
    fi

    if [[ -z "$u" || "$u" == "$HOME" ]] && command -v xdg-user-dir >/dev/null 2>&1; then
        u="$(xdg-user-dir PICTURES 2>/dev/null || true)"
    fi

    if [[ -z "$u" || "$u" == "$HOME" ]]; then
        u="$HOME/Pictures"
    fi

    printf '%s/Wallpapers\n' "${u%/}"
    return 0
}

install_wallpapers() {
    local full="${1:-true}"
    local dir clone src ok=false
    dir="$(get_wallpaper_dir)"
    clone="${XDG_CACHE_HOME:-$HOME/.cache}/serpantinum-wallpapers"

    mkdir -p "$dir"

    if [[ -d "$clone/.git" ]] &&
       git -C "$clone" fetch --depth 1 origin &&
       git -C "$clone" reset --hard FETCH_HEAD; then
        ok=true
    fi

    if [[ "$ok" != true ]]; then
        rm -rf "$clone"
        if ! git clone --depth 1 "$WALLPAPER_REPO" "$clone"; then
            log_warn 'Обои: клон не удался (сеть)'
            return 0
        fi
    fi

    src="$clone"
    if [[ -d "$clone/images" ]]; then
        src="$clone/images"
    fi

    if [[ ! -d "$src" ]]; then
        return 0
    fi

    local files=() f

    if [[ "$full" == true ]]; then
        while IFS= read -r -d '' f; do
            files+=("$f")
        done < <(find "$src" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.webp' \) -print0)
    else
        if command -v shuf >/dev/null 2>&1; then
            while IFS= read -r -d '' f; do
                files+=("$f")
            done < <(find "$src" -type f \( -iname '*.jpg' -o -iname '*.png' -o -iname '*.webp' \) -print0 | shuf -z -n 3)
        else
            while IFS= read -r -d '' f; do
                files+=("$f")
            done < <(find "$src" -type f \( -iname '*.jpg' -o -iname '*.png' -o -iname '*.webp' \) -print0 | head -z -n 3)
        fi
    fi

    if [[ ${#files[@]} -eq 0 ]]; then
        log_warn 'Обои: файлов не найдено'
        return 0
    fi

    for f in "${files[@]}"; do
        cp -f "$f" "$dir/" 2>/dev/null || true
    done

    log_ok "Обои: ${#files[@]} файлов."
    return 0
}

other_display_manager_enabled() {
    local link
    link="$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null || true)"

    if [[ -n "$link" && "$link" != *sddm* ]]; then
        return 0
    fi

    local dm
    for dm in gdm lightdm greetd lxdm; do
        if systemctl is-active --quiet "$dm.service" 2>/dev/null ||
           systemctl is-enabled --quiet "$dm.service" 2>/dev/null; then
            return 0
        fi
    done

    return 1
}

ensure_sddm_package() {
    if [[ "$DISTRO" == fedora ]]; then
        local pkgs=("${SDDM_PKGS[@]}")
        if [[ ${#pkgs[@]} -eq 0 ]]; then
            pkgs=(sddm qt6-qtdeclarative qt6-qtsvg)
        fi
        local missing=()
        local pkg
        for pkg in "${pkgs[@]}"; do
            if ! pkg_installed "$pkg"; then
                missing+=("$pkg")
            fi
        done

        if [[ ${#missing[@]} -eq 0 ]]; then
            return 0
        fi

        run_root dnf install -y "${missing[@]}" || return 1
    else
        local sddm_atoms=(x11-misc/sddm dev-qt/qtdeclarative dev-qt/qtsvg)
        if [[ "$(detect_init_system)" == openrc ]]; then
            sddm_atoms+=(gui-libs/display-manager-init)
        fi

        local missing=()
        for a in "${sddm_atoms[@]}"; do
            if ! pkg_installed "$a"; then
                missing+=("$a")
            fi
        done

        if [[ ${#missing[@]} -eq 0 ]]; then
            return 0
        fi

        run_root emerge --ask=n "${missing[@]}" || return 1
    fi

    return 0
}

setup_sddm() {
    local repo="$1"

    if [[ "$OPT_SDDM" != true ]]; then
        return 0
    fi

    if ! ensure_sddm_package; then
        log_warn 'SDDM: пакет не установлен'
        return 0
    fi

    local src="$repo/config/sddm/themes/material-you"
    if [[ ! -d "$src" ]]; then
        log_warn 'SDDM: тема не найдена в репо'
        return 0
    fi

    if [[ -d "$SDDM_THEME_DIR" ]] && ! is_sddm_theme_managed; then
        log_warn "Каталог темы SDDM $SDDM_THEME_DIR уже существует и не управляется linka (нет метки .linka-managed). Пропускаю установку темы SDDM."
    else
        if ! run_root mkdir -p /etc/sddm.conf.d "$SDDM_THEME_DIR"; then
            log_warn 'SDDM: не удалось создать каталоги'
            return 0
        fi

        if ! run_root cp -a "$src/." "$SDDM_THEME_DIR/"; then
            log_warn 'SDDM: не удалось скопировать тему'
            return 0
        fi

        run_root touch "$SDDM_THEME_DIR/.linka-managed" 2>/dev/null || true
        run_root chmod -R a+rX "$SDDM_THEME_DIR" || true

        if ! run_root tee "$SDDM_MANAGED_CONF" >/dev/null <<'EOF_SDDM'
[Theme]
Current=material-you
ThemeDir=/usr/share/sddm/themes

[General]
InputMethod=
EOF_SDDM
        then
            log_warn 'SDDM: не удалось записать конфиг'
            return 0
        fi
    fi

    if [[ "$(detect_init_system)" == systemd ]]; then
        if other_display_manager_enabled; then
            log_warn 'SDDM: тема установлена, но в системе включён другой display manager — sddm.service не включаю (переключите вручную при желании)'
            return 0
        fi

        if run_root systemctl enable sddm.service; then
            update_state_field SDDM_ENABLED_BY_LINKA true
        else
            log_warn 'SDDM: не удалось включить sddm.service'
            return 0
        fi
    elif [[ "$(detect_init_system)" == openrc ]]; then
        if [[ -f /etc/conf.d/display-manager ]]; then
            run_optional_root sed -i 's/^[#[:space:]]*DISPLAYMANAGER=.*/DISPLAYMANAGER="sddm"/' /etc/conf.d/display-manager 2>/dev/null || true
        else
            printf 'DISPLAYMANAGER="sddm"\n' | run_optional_root tee /etc/conf.d/display-manager >/dev/null || true
        fi

        if run_optional_root rc-update add display-manager default 2>/dev/null || run_optional_root rc-update add sddm default 2>/dev/null; then
            update_state_field SDDM_ENABLED_BY_LINKA true
        else
            log_warn 'SDDM: не удалось добавить display-manager/sddm в rc-update'
        fi
    fi

    log_ok 'SDDM настроен.'
    return 0
}

detect_system_language() {
    local repo="$1"
    local locale="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
    local lang="${locale%%[_.@]*}"
    lang="${lang,,}"

    if [[ "$lang" == uk ]]; then lang=ua; fi

    if [[ -n "$lang" && -f "$repo/src/assets/languages/${lang}.json" ]]; then
        printf '%s' "$lang"
    else
        printf 'en'
    fi
    return 0
}

refresh_location() {
    local script="$TARGET_BASE/src/scripts/location.sh"

    if [[ ! -f "$script" ]]; then
        return 0
    fi

    log_info 'Определяю локацию (погода)...'
    if command -v timeout >/dev/null 2>&1; then
        timeout 30 env -u SERPANTINUM_DIR -u QS_DIR -u MAIN_QML bash "$script" --refresh >/dev/null 2>&1 || true
    else
        env -u SERPANTINUM_DIR -u QS_DIR -u MAIN_QML bash "$script" --refresh >/dev/null 2>&1 || true
    fi

    return 0
}

ensure_ownership_marker() {
    mkdir -p "$TARGET_BASE"

    if [[ ! -f "$OWNERSHIP_MARKER" ]]; then
        printf 'owner=linka\nversion=%s\nrepo=%s\n' "$LINKA_VERSION" "$REPO_SLUG" > "$OWNERSHIP_MARKER"
    fi

    return 0
}

get_compositor_config_dir_name() {
    case "$1" in
        hyprland) printf 'hypr\n' ;;
        niri)     printf 'niri\n' ;;
        sway)     printf 'sway\n' ;;
        mango)    printf 'mango\n' ;;
        *)        printf '%s\n' "$1" ;;
    esac
}

compositor_config_needs_deploy() {
    local comp="$1"
    local dir
    dir="$HOME/.config/$(get_compositor_config_dir_name "$comp")"

    if [[ "$comp" == mango ]]; then
        [[ ! -f "$dir/config.conf" ]]
        return $?
    fi

    [[ ! -d "$dir" || -z "$(ls -A "$dir" 2>/dev/null || true)" ]]
}

selected_compositor_config_missing() {
    local comp
    for comp in "${SELECTED_COMPOSITORS[@]}"; do
        [[ -d "$PROJECT_ROOT/compositors/$comp" || -d "$PROJECT_ROOT/compositor/$comp" ]] || continue
        if [[ "$comp" == mango && " ${SELECTED_COMPOSITORS_SAVED[*]} " != *" mango "* ]]; then
            return 0
        fi
        if compositor_config_needs_deploy "$comp"; then
            return 0
        fi
    done
    return 1
}

deploy_compositor_config() {
    local repo="$1"
    local c="$2"
    local dn src tgt

    dn="$(get_compositor_config_dir_name "$c")"
    src=''

    if [[ -d "$repo/compositors/$c" ]]; then
        src="$repo/compositors/$c"
    fi

    if [[ -z "$src" && -d "$repo/compositor/$c" ]]; then
        src="$repo/compositor/$c"
    fi

    if [[ -z "$src" ]]; then
        return 0
    fi

    tgt="$HOME/.config/$dn"
    if [[ -L "$tgt" ]]; then
        log_warn "$HOME/.config/$dn — симлинк; пропускаю развёртывание, чтобы не менять его целевой каталог."
        return 0
    fi
    if ! backup_user_config "$dn"; then
        log_warn "Пропускаю развёртывание конфига $c в ~/.config/$dn, так как бэкап не удался."
        return 1
    fi
    mkdir -p "$tgt"
    if ! cp -a --remove-destination "$src/." "$tgt/"; then
        log_error "Не удалось развернуть конфиг $c в ~/.config/$dn"
        return 1
    fi
    log_ok "Конфиг $c развёрнут в ~/.config/$dn"

    return 0
}

prune_removed_files() {
    local repo="$1"
    local oc="$2"
    local f deleted_tmp removed=0

    if [[ -z "$oc" || "$oc" == unknown || ! -d "$repo/.git" ]]; then
        return 1
    fi

    if ! git -C "$repo" cat-file -e "${oc}^{commit}" 2>/dev/null; then
        return 1
    fi

    deleted_tmp="$(mktemp)" || return 1

    if ! git -C "$repo" diff -z --name-only --no-renames --diff-filter=D "$oc" HEAD -- bin src > "$deleted_tmp" 2>/dev/null; then
        rm -f "$deleted_tmp"
        return 1
    fi

    while IFS= read -r -d '' f; do
        if [[ -e "$TARGET_BASE/$f" || -L "$TARGET_BASE/$f" ]]; then
            rm -f "$TARGET_BASE/$f"
            removed=$((removed+1))
        fi
    done < "$deleted_tmp"

    rm -f "$deleted_tmp"

    if [[ "$removed" -gt 0 ]]; then
        find "$TARGET_BASE/bin" "$TARGET_BASE/src" -mindepth 1 -type d -empty -delete 2>/dev/null || true
        log_info "Удалено устаревших файлов (были в старой версии, нет в новой): $removed"
    fi

    return 0
}

deploy_incremental() {
    local repo="$1"
    local oc="$2"
    local f

    if [[ "$FORCE_UPDATE" == 1 || -z "$oc" || "$oc" == unknown || ! -d "$repo/.git" ]]; then
        return 1
    fi

    if [[ ! -d "$TARGET_BASE/src" ]]; then
        return 1
    fi

    if ! git -C "$repo" cat-file -e "${oc}^{commit}" 2>/dev/null; then
        return 1
    fi

    local changed_tmp
    changed_tmp="$(mktemp)" || return 1

    if ! git -C "$repo" diff -z --name-only --no-renames --diff-filter=AMT "$oc" HEAD -- bin src > "$changed_tmp" 2>/dev/null; then
        rm -f "$changed_tmp"
        return 1
    fi

    prune_removed_files "$repo" "$oc" || {
        rm -f "$changed_tmp"
        return 1
    }

    local cp_failed=0

    while IFS= read -r -d '' f; do
        if [[ -L "$TARGET_BASE/$(dirname "$f")" ]]; then
            cp_failed=1
            continue
        fi
        if ! mkdir -p "$(dirname "$TARGET_BASE/$f")" ||
           ! cp -a --remove-destination -- "$repo/$f" "$TARGET_BASE/$f"; then
            cp_failed=1
            log_warn "Не удалось скопировать: $f"
            continue
        fi

        if [[ "$f" == bin/* || "$f" == *.sh ]]; then
            chmod +x "$TARGET_BASE/$f" 2>/dev/null || true
        fi
    done < "$changed_tmp"

    rm -f "$changed_tmp"

    if [[ "$cp_failed" -eq 1 ]]; then
        log_warn 'Инкрементальное обновление прошло с ошибками — перехожу на полное копирование'
        return 1
    fi

    log_info "Инкрементальное обновление: $oc → $(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo HEAD)"
    return 0
}

copy_tree_full() {
    local repo="$1"

    if [[ -d "$repo/bin" ]]; then
        cp -a "$repo/bin/." "$TARGET_BASE/bin/" || return 1
    fi

    if [[ -d "$repo/src" ]]; then
        cp -a "$repo/src/." "$TARGET_BASE/src/" || return 1
    fi

    if [[ -f "$repo/version.txt" ]]; then
        cp -a "$repo/version.txt" "$TARGET_BASE/version.txt" 2>/dev/null || true
    fi

    return 0
}

fix_exec_bits() {
    find "$TARGET_BASE/src" -type f -name '*.sh' -exec chmod +x {} + 2>/dev/null || true
    find "$TARGET_BASE/bin" -type f -exec chmod +x {} + 2>/dev/null || true
    return 0
}

verify_deploy() {
    local repo="$1"
    local f rel bad=0 missing_count=0

    for rel in bin/serpantinumd bin/serpantinum; do
        if [[ -f "$repo/$rel" && ! -x "$TARGET_BASE/$rel" ]]; then
            log_warn "Проверка деплоя: $rel отсутствует или не исполняемый"
            bad=1
        fi
    done

    if [[ -d "$repo/src/quickshell" && ! -d "$TARGET_BASE/src/quickshell" ]]; then
        log_warn 'Проверка деплоя: нет каталога src/quickshell'
        bad=1
    fi

    if [[ -d "$repo/.git" ]]; then
        while IFS= read -r -d '' f; do
            if [[ ! -e "$TARGET_BASE/$f" && ! -L "$TARGET_BASE/$f" ]]; then
                missing_count=$((missing_count+1))
                if [[ "$missing_count" -le 5 ]]; then
                    log_warn "Проверка деплоя: нет файла $f"
                fi
            elif [[ -L "$repo/$f" ]]; then
                if [[ ! -L "$TARGET_BASE/$f" || "$(readlink -- "$repo/$f")" != "$(readlink -- "$TARGET_BASE/$f")" ]]; then
                    log_warn "Проверка деплоя: неверный симлинк $f"
                    bad=1
                fi
            elif [[ ! -f "$TARGET_BASE/$f" || -L "$TARGET_BASE/$f" ]] || ! cmp -s -- "$repo/$f" "$TARGET_BASE/$f"; then
                log_warn "Проверка деплоя: неверное содержимое или тип $f"
                bad=1
            fi
        done < <(git -C "$repo" ls-files -z -- bin src 2>/dev/null)
    fi

    if [[ "$missing_count" -gt 0 ]]; then
        log_warn "Проверка деплоя: не хватает файлов: $missing_count"
        bad=1
    fi

    if [[ "$bad" -ne 0 ]]; then
        return 1
    fi

    return 0
}

deploy_full() {
    local repo="$1"
    local is_update="$2"
    shift 2

    local comps=("$@")
    local c src tgt backup_dir

    CONFIG_BACKUP_DIR=""

    if [[ ! -d "$repo" ]]; then
        return 1
    fi

    if [[ ! -d "$repo/bin" && ! -d "$repo/src" ]]; then
        log_error 'В репозитории нет каталогов bin/ и src/.'
        return 1
    fi

    if [[ "$is_update" == true ]]; then
        mkdir -p "$TARGET_BASE/bin" "$TARGET_BASE/src" "$BIN_DIR"
        ensure_ownership_marker
    else
        if [[ -e "$TARGET_BASE" ]]; then
            mkdir -p "$BACKUP_BASE"
            backup_dir="${BACKUP_BASE}/target.$(date +%Y%m%d_%H%M%S)"

            if ! mv "$TARGET_BASE" "$backup_dir"; then
                log_error "Не удалось переместить старый $TARGET_BASE в $backup_dir: переустановка прервана, ничего не удалено."
                return 1
            fi
        fi

        mkdir -p "$TARGET_BASE/bin" "$TARGET_BASE/src" "$BIN_DIR"
        ensure_ownership_marker
    fi

    local incremental_ok=false

    if [[ "$is_update" == true ]] && deploy_incremental "$repo" "$DEPLOY_OLD_COMMIT"; then
        incremental_ok=true
    else
        copy_tree_full "$repo" || return 1

        if [[ "$is_update" == true ]]; then
            if ! prune_removed_files "$repo" "$DEPLOY_OLD_COMMIT"; then
                log_warn 'Не удалось определить устаревшие файлы (старый коммит недоступен) — в target могли остаться лишние файлы; чтобы убрать их, выполните linka reinstall.'
            fi
        fi
    fi

    fix_exec_bits

    if ! verify_deploy "$repo"; then
        if [[ "$incremental_ok" == true ]]; then
            log_warn 'Проверка после инкрементального обновления не прошла — делаю полное копирование.'
            copy_tree_full "$repo" || return 1
            fix_exec_bits

            if ! verify_deploy "$repo"; then
                log_error 'Деплой не прошёл проверку целостности.'
                return 1
            fi
        else
            log_error 'Деплой не прошёл проверку целостности.'
            return 1
        fi
    fi

    if [[ "$is_update" != true ]]; then
        for c in kitty cava fastfetch; do
            src="$repo/config/$c"
            tgt="$HOME/.config/$c"

            if [[ -e "$src" ]]; then
                if [[ -L "$tgt" ]]; then
                    log_warn "$HOME/.config/$c — симлинк; пропускаю развёртывание, чтобы не менять его целевой каталог."
                    continue
                fi
                if ! backup_user_config "$c"; then
                    log_error "Не удалось сохранить конфиг $c перед развёртыванием."
                    return 1
                fi
                mkdir -p "$(dirname "$tgt")"

                if [[ -d "$src" ]]; then
                    mkdir -p "$tgt"
                    if ! cp -a --remove-destination "$src/." "$tgt/"; then
                        log_error "Не удалось развернуть конфиг $c в ~/.config/$c"
                        return 1
                    fi
                else
                    if ! cp -a --remove-destination "$src" "$tgt"; then
                        log_error "Не удалось развернуть конфиг $c в ~/.config/$c"
                        return 1
                    fi
                fi
            fi
        done

        if [[ ${#comps[@]} -gt 0 ]]; then
            for c in "${comps[@]}"; do
                deploy_compositor_config "$repo" "$c" || return 1
            done
        fi
    else
        if [[ ${#comps[@]} -gt 0 ]]; then
            for c in "${comps[@]}"; do
                if compositor_config_needs_deploy "$c"; then
                    deploy_compositor_config "$repo" "$c" || return 1
                fi
            done
        fi
    fi

    return 0
}

deploy_package() {
    local repo="$1"
    local oc="$2"
    local nc="$3"
    local rei="$4"
    local ist="$5"
    shift 5

    local comps=("$@")
    local iu=false

    : "$nc"
    DEPLOY_OLD_COMMIT="$oc"

    if [[ "$ist" == current && "$rei" != true ]]; then
        iu=true
    fi

    if [[ ${#comps[@]} -gt 0 ]]; then
        deploy_full "$repo" "$iu" "${comps[@]}" || return 1
    else
        deploy_full "$repo" "$iu" || return 1
    fi

    if [[ -f "$TARGET_BASE/bin/serpantinum" || -f "$TARGET_BASE/bin/serpantinumd" ]]; then
        run_optional_root mkdir -p /usr/local/bin || true
    fi

    if [[ -f "$TARGET_BASE/bin/serpantinum" ]]; then
        ln -sfn "$TARGET_BASE/bin/serpantinum" "$BIN_DIR/serpantinum"
        run_optional_root ln -sfn "$TARGET_BASE/bin/serpantinum" /usr/local/bin/serpantinum || true
    fi

    if [[ -f "$TARGET_BASE/bin/serpantinumd" ]]; then
        ln -sfn "$TARGET_BASE/bin/serpantinumd" "$BIN_DIR/serpantinumd"
        run_optional_root ln -sfn "$TARGET_BASE/bin/serpantinumd" /usr/local/bin/serpantinumd || true
    fi

    return 0
}

matugen_supports_source_color_index() {
    local help

    if ! command -v matugen >/dev/null 2>&1; then
        return 2
    fi

    help="$(matugen image --help 2>&1 || true)"

    if [[ -z "$help" ]]; then
        return 2
    fi

    if grep -q -- '--source-color-index' <<< "$help"; then
        return 0
    fi

    return 1
}

fix_matugen_compat() {
    if [[ "${SERPANTINUM_MATUGEN_COMPAT:-auto}" == "0" ]]; then
        return 0
    fi

    local qml="$TARGET_BASE/src/quickshell/singletons/theme/Matugen.qml"
    local cfg="$TARGET_BASE/src/assets/matugen/config.toml"
    local tpl="$TARGET_BASE/src/assets/matugen/templates"
    local rc=0

    matugen_supports_source_color_index || rc=$?

    if [[ "$rc" -eq 1 && -f "$qml" ]] && grep -q 'source-color-index' "$qml"; then
        local qml_bak="${qml}.linka-bak"
        cp -a "$qml" "$qml_bak" 2>/dev/null || true

        if sed -i '/source-color-index/d' "$qml"; then
            log_ok 'Matugen: убран флаг --source-color-index (не поддерживается установленным matugen)'
        else
            mv -f "$qml_bak" "$qml" 2>/dev/null || true
            log_warn 'Не удалось безопасно применить matugen QML compat'
        fi
    fi

    if [[ -f "$cfg" && -d "$tpl" ]] && grep -q 'input_path = "templates/' "$cfg"; then
        local cfg_bak="${cfg}.linka-bak"
        cp -a "$cfg" "$cfg_bak" 2>/dev/null || true

        if sed -i "s|input_path = \"templates/|input_path = \"$tpl/|g" "$cfg"; then
            log_ok 'Matugen: пути шаблонов сделаны абсолютными'
        else
            mv -f "$cfg_bak" "$cfg" 2>/dev/null || true
            log_warn 'Не удалось поправить matugen config.toml'
        fi
    fi

    return 0
}

matugen_needs_repair() {
    local repo_qml="$1/src/quickshell/singletons/theme/Matugen.qml"
    local target_qml="$TARGET_BASE/src/quickshell/singletons/theme/Matugen.qml"
    local rc=0

    if [[ "${SERPANTINUM_MATUGEN_COMPAT:-auto}" == "0" ]]; then
        return 1
    fi

    if [[ -f "$repo_qml" && ! -f "$target_qml" ]]; then
        return 0
    fi

    if [[ -f "$repo_qml" && -f "$target_qml" ]]; then
        matugen_supports_source_color_index || rc=$?

        if [[ "$rc" -eq 0 ]] &&
           grep -q 'source-color-index' "$repo_qml" 2>/dev/null &&
           ! grep -q 'source-color-index' "$target_qml" 2>/dev/null; then
            return 0
        fi
    fi

    return 1
}

merge_serpantinum_config() {
    local repo="$1"
    local tj="$repo/config/serpantinum/settings.json"
    local tmp wp lang

    [[ ! -L "$CONFIG_DIR" ]] || return 1
    mkdir -p "$CONFIG_DIR" || return 1

    if [[ ! -f "$tj" ]]; then
        if [[ ! -f "$CONFIG_FILE" ]]; then
            printf '{}\n' > "$CONFIG_FILE"
        fi
        return 0
    fi

    if ! command -v jq >/dev/null 2>&1; then
        if [[ ! -f "$CONFIG_FILE" ]]; then
            cp -a "$tj" "$CONFIG_FILE" 2>/dev/null || true
        fi
        return 0
    fi

    wp="$(get_wallpaper_dir)"
    lang="$(detect_system_language "$repo")"

    if [[ ! -f "$CONFIG_FILE" || ! -s "$CONFIG_FILE" ]]; then
        tmp="$(mktemp "$CONFIG_DIR/.settings.XXXXXX")" || return 0

        if jq --arg wp "$wp" --arg lang "$lang" '
            . + (if ($wp|length)>0 then {wallpaperDir:$wp} else {} end)
            | if ((.general.language // "") | length) == 0
              then .general = ((.general // {}) + {language:$lang})
              else .
              end
        ' "$tj" > "$tmp" 2>/dev/null; then
            chmod 600 "$tmp" 2>/dev/null || true
            mv -f "$tmp" "$CONFIG_FILE"
        else
            rm -f "$tmp"
            cp -a "$tj" "$CONFIG_FILE" 2>/dev/null || true
        fi

        return 0
    fi

    tmp="$(mktemp "$CONFIG_DIR/.settings.XXXXXX")" || return 0

    if jq -s --arg wp "$wp" --arg lang "$lang" '
        (.[0] * .[1])
        | if ((.wallpaperDir // "") | length) == 0 and ($wp|length)>0
          then .wallpaperDir = $wp
          else .
          end
        | if ((.general.language // "") | length) == 0
          then .general = ((.general // {}) + {language:$lang})
          else .
          end
    ' "$tj" "$CONFIG_FILE" > "$tmp" 2>/dev/null; then
        chmod 600 "$tmp" 2>/dev/null || true
        mv -f "$tmp" "$CONFIG_FILE"
    else
        rm -f "$tmp"
        log_warn "Не удалось смержить settings.json; оставляю пользовательский конфиг"
    fi

    return 0
}

run_user_post_update_hook() {
    local user_hook="$CONFIG_DIR/hooks/post_update.sh"
    if [[ ! -e "$user_hook" ]]; then
        return 0
    fi
    if [[ ! -x "$user_hook" ]]; then
        log_warn "Пользовательский хук $user_hook найден, но не имеет прав на выполнение (chmod +x)."
        return 0
    fi

    log_info "Выполняю пользовательский хук: $user_hook"
    (
        export TARGET_DIR="${TARGET_DIR:-$TARGET_BASE}"
        export TARGET_BASE="$TARGET_BASE"
        export CONFIG_DIR="$CONFIG_DIR"
