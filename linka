#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
linka — Автономный установщик и менеджер обновлений Serpantinum для Gentoo и Fedora Linux.
Спроектировано и реализовано с помощью искусственного интеллекта (AI-assisted).
"""

import sys
from pathlib import Path

# Добавляем родительский каталог в sys.path для корректного импорта linka_modules
ROOT_DIR = Path(__file__).resolve().parent
if str(ROOT_DIR) not in sys.path:
    sys.path.insert(0, str(ROOT_DIR))

try:
    from linka_modules.ui import main
except ImportError as e:
    print(f"Ошибка загрузки модулей linka: {e}", file=sys.stderr)
    print("Убедитесь, что каталог linka_modules находится рядом со скриптом linka.", file=sys.stderr)
    sys.exit(1)

if __name__ == "__main__":
    main()
