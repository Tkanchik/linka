flow_install() {
    local requested="$1"
    shift || true
    local sel

    linka_recover_transaction || return 1
    INSTALL_STATE="$(detect_install_state)"

    load_state
    OLD_VERSION="$(get_installed_version)"
    TARGET_VERSION="$(get_target_version "$PROJECT_ROOT")"
    TARGET_COMMIT="$(get_target_commit "$PROJECT_ROOT")"

    IS_REINSTALL=false

    if [[ "$requested" == reinstall ]]; then
        IS_REINSTALL=true
    fi

    local cli_comps=()
    local comp_arg
    for comp_arg in "$@"; do
        case "${comp_arg,,}" in
            hyprland|niri|sway|mango)
                cli_comps+=("${comp_arg,,}")
                ;;
        esac
    done
    if [[ ${#cli_comps[@]} -gt 0 ]]; then
        SELECTED_COMPOSITORS=("${cli_comps[@]}")
    fi

    init_compositor_detection

    if ! run_installer_ui; then
        log_info 'Установка отменена.'
        return 0
    fi

    sel="$(selected_compositors_string)"
    log_info "Установка: distro=$DISTRO | compositor=${sel:-none} | SDDM=$OPT_SDDM | target=$TARGET_VERSION ($TARGET_COMMIT)"

    if [[ "$INSTALL_STATE" == current && "$IS_REINSTALL" != true ]]; then
        log_info 'Serpantinum уже установлен: файлы обновляются поверх, пользовательские конфиги не перезаписываются (для чистой установки — linka reinstall).'
        linka_update_session_ready || return 1
    fi

    if [[ ${#SELECTED_COMPOSITORS[@]} -gt 0 ]]; then
        install_dependencies "${SELECTED_COMPOSITORS[@]}" || return 1
    else
        install_dependencies || return 1
    fi

    ensure_mango_compatible || return 1

    install_fonts || true

    if [[ "$INSTALL_STATE" == current && "$IS_REINSTALL" != true ]]; then
        OLD_COMMIT="$(get_installed_commit)"
        transactional_deploy_update "$PROJECT_ROOT" || return 1
        setup_sddm "$PROJECT_ROOT" || true
        install_wallpapers "$INSTALL_FULL_WALLPAPERS" || true
        setup_services || true
        rotate_backups || true
        return 0
    fi

    stop_shell || log_warn 'shell не остановлен штатно'

    OLD_COMMIT="$(get_installed_commit)"

    if [[ ${#SELECTED_COMPOSITORS[@]} -gt 0 ]]; then
        if ! deploy_package "$PROJECT_ROOT" "$OLD_COMMIT" "$TARGET_COMMIT" "$IS_REINSTALL" "$INSTALL_STATE" "${SELECTED_COMPOSITORS[@]}"; then
            log_error 'Deploy не удался.'
            return 1
        fi
    else
        if ! deploy_package "$PROJECT_ROOT" "$OLD_COMMIT" "$TARGET_COMMIT" "$IS_REINSTALL" "$INSTALL_STATE"; then
            log_error 'Deploy не удался.'
            return 1
        fi
    fi

    sync_sounds_from_repo "$PROJECT_ROOT" || true
    fix_matugen_compat || true
    setup_sddm "$PROJECT_ROOT" || true
    install_wallpapers "$INSTALL_FULL_WALLPAPERS" || true
    merge_serpantinum_config "$PROJECT_ROOT" || true
    setup_services || true

    if [[ "$INSTALL_STATE" != current || "$IS_REINSTALL" == true ]]; then
        refresh_location || true
    fi

    rm -f "$STATE_DIR/first_launch.done" "$HOME/.local/state/quickshell/first_launch.done" 2>/dev/null || true

    mark_shell_state || true
    write_version_file || true

    run_user_post_update_hook || true

    if start_shell; then
        log_ok "Serpantinum $TARGET_VERSION ($TARGET_COMMIT) запущен."
    else
        log_warn "Установка завершена, но shell не стартовал. Запусти вручную: serpantinumd start"
    fi

    if [[ ${#FAILED_PKGS[@]} -gt 0 ]]; then
        log_warn "Проблемы с пакетами: ${FAILED_PKGS[*]}"
    fi

    rotate_backups || true
    return 0
}

flow_update() {
    linka_recover_transaction || return 1
    if ! is_installed; then
        log_info 'Не установлен — переключаюсь на установку.'
        flow_install install
        return $?
    fi

    load_state
    init_compositor_detection

    OLD_COMMIT="$(get_installed_commit)"
    OLD_VERSION="$(get_installed_version)"
    TARGET_COMMIT="$(get_target_commit "$PROJECT_ROOT")"
    TARGET_VERSION="$(get_target_version "$PROJECT_ROOT")"

    if [[ "$OLD_COMMIT" == "$TARGET_COMMIT" && "$OLD_COMMIT" != unknown && "$FORCE_UPDATE" != 1 ]]; then
        if selected_compositor_config_missing; then
            log_info 'Для выбранного композитора ещё нет конфига — разворачиваю его.'
            FORCE_UPDATE=1
        elif selected_mango_needs_upgrade; then
            log_info 'MangoWM требует обновления до версии 0.18+.'
            FORCE_UPDATE=1
        elif matugen_needs_repair "$PROJECT_ROOT"; then
            log_info 'Коммит не изменился, но Matugen повреждён — восстанавливаю файлы.'
            FORCE_UPDATE=1
        else
            log_ok "Уже на $TARGET_VERSION ($TARGET_COMMIT)."
            log_info 'Если цвета обоев пропали, запусти принудительно: linka update --force'
            return 0
        fi
    fi

    if [[ "$FORCE_UPDATE" == 1 ]]; then
        log_info 'Принудительное обновление включено.'
    fi

    local sel
    sel="$(selected_compositors_string)"

    log_info "Обновление: $OLD_VERSION ($OLD_COMMIT) -> $TARGET_VERSION ($TARGET_COMMIT)"
    log_info "Ветка: ${ACTIVE_REPO_BRANCH:-$REPO_BRANCH}"
    log_info "Compositors: ${sel:-none}"

    linka_update_session_ready || return 1

    if [[ "$AUTO_MODE" != 1 ]]; then
        ensure_update_dependencies || return 1
        if selected_mango_needs_upgrade; then
            install_dependencies mango || return 1
        fi
    else
        verify_required_dependencies "${SELECTED_COMPOSITORS[@]}" || return 1
    fi
    ensure_mango_compatible || return 1
    transactional_deploy_update "$PROJECT_ROOT" || return 1
    if [[ "$AUTO_MODE" != 1 ]]; then
        setup_services || true
    fi

    rotate_backups || true
    return 0
}

emergency_remove() {
    local c sddm_ours='' rb
    local sddm_theme_managed=false font_sys_managed=false

    clear 2>/dev/null || true
    printf '%sУДАЛЕНИЕ SERPANTINUM%s\n' "$BOLD" "$RESET"

    read -r -p 'Продолжить? [y/N] ' c || true
    if [[ ! "$c" =~ ^[Yy]$ ]]; then
        log_info 'Отменено.'
        return 0
    fi

    acquire_lock
    linka_recover_transaction || return 1
    start_sudo_keepalive

    sddm_ours="$(state_get SDDM_ENABLED_BY_LINKA || true)"

    if is_sddm_theme_managed; then
        sddm_theme_managed=true
    fi
    if is_font_system_managed; then
        font_sys_managed=true
    fi

    if [[ -d "$CONFIG_DIR" && -n "$(ls -A "$CONFIG_DIR" 2>/dev/null || true)" ]]; then
        rb="$BACKUP_BASE/removed.$(date +%Y%m%d_%H%M%S)"
        if ! mkdir -p "$rb" || ! cp -a "$CONFIG_DIR/." "$rb/" 2>/dev/null; then
            log_error "Не удалось сохранить настройки в $rb. Удаление отменено, файлы не затронуты."
            end_session
            return 1
        fi
        log_info "Настройки сохранены: $rb"
    fi

    kill_serpantinum || true

    auto_disable --quiet || true

    if [[ -d "$TARGET_BASE" ]]; then
        rm -rf "$TARGET_BASE"
    fi
    if [[ -d "$GENERATIONS_BASE" && ! -L "$GENERATIONS_BASE" ]]; then
        rm -rf -- "$GENERATIONS_BASE"
    fi

    rm -rf "$CONFIG_DIR"
    rm -f "$BIN_DIR/serpantinum" "$BIN_DIR/serpantinumd"
    run_optional_root rm -f /usr/local/bin/serpantinum /usr/local/bin/serpantinumd || true

    if [[ -f "$SDDM_MANAGED_CONF" ]]; then
        run_optional_root rm -f "$SDDM_MANAGED_CONF" || true
    fi

    if [[ -d "$SDDM_THEME_DIR" ]]; then
        if [[ "$sddm_theme_managed" == true ]]; then
            run_optional_root rm -rf "$SDDM_THEME_DIR" || true
        else
            log_warn "Каталог темы SDDM $SDDM_THEME_DIR не принадлежит linka — оставляю нетронутым. Для ручного удаления: sudo rm -rf '$SDDM_THEME_DIR'"
        fi
    fi

    if [[ -d "$FONT_SYSTEM_DIR" ]]; then
        if [[ "$font_sys_managed" == true ]]; then
            run_optional_root rm -rf "$FONT_SYSTEM_DIR" || true
        else
            log_warn "Каталог системных шрифтов $FONT_SYSTEM_DIR не принадлежит linka — оставляю нетронутым. Для ручного удаления: sudo rm -rf '$FONT_SYSTEM_DIR'"
        fi
    fi

    if [[ -d "$USER_FONT_DIR" ]]; then
        log_warn "Пользовательские шрифты в $USER_FONT_DIR оставлены: каталог может содержать файлы, установленные не linka."
    fi

    if [[ "$sddm_ours" == true ]]; then
        if [[ "$(detect_init_system)" == systemd ]] && command -v systemctl >/dev/null 2>&1; then
            run_optional_root systemctl disable sddm.service || true
            log_warn 'sddm.service отключён — при следующей загрузке нужен другой способ входа (или включите свой DM).'
        elif [[ "$(detect_init_system)" == openrc ]] && command -v rc-update >/dev/null 2>&1; then
            run_optional_root rc-update del sddm default 2>/dev/null || run_optional_root rc-update del display-manager default 2>/dev/null || true
            log_warn 'sddm удалён из автозапуска OpenRC — при следующей загрузке нужен другой способ входа.'
        fi
    fi

    rm -f "$STATE_FILE" "$STATE_DIR/version" "$STATE_DIR/.last-update-backup" 2>/dev/null || true
    rm -rf "$STATE_DIR/sounds" 2>/dev/null || true

    end_session
    log_ok 'Serpantinum удалён.'
    return 0
}









































LINKA_LIB_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/lib"
for linka_module in common distro gentoo fedora services deploy backup ui auto transaction diagnostics; do
    source "$LINKA_LIB_DIR/$linka_module.sh"
done

main() {
    local operation="${1:-}" arg
    case "$operation" in
        install|--install) operation=install ;;
        reinstall|--reinstall) operation=reinstall ;;
        update|--update) operation=update ;;
        remove|--remove|uninstall|--uninstall) operation=remove ;;
        rollback) ;;
    esac
    case "$operation" in
        install|reinstall|update|remove|rollback)
            for arg in "${@:2}"; do
                if [[ "$arg" == --dry-run ]]; then
                    linka_dry_run "$operation"
                    return $?
                fi
            done
            ;;
    esac
    case "${1:-}" in
        -h|--help)
            usage
            ;;
        install|--install)
            shift
            prepare_environment
            linka_run_reported install flow_install install "$@"
            ;;
        reinstall|--reinstall)
            shift
            prepare_environment
            linka_run_reported reinstall flow_install reinstall "$@"
            ;;
        update|--update)
            if [[ "${2:-}" == "--force" || "${2:-}" == "-f" ]]; then
                FORCE_UPDATE=1
            fi

            prepare_environment
            linka_run_reported update flow_update
            ;;
        rollback)
            acquire_lock
            linka_recover_transaction || return 1
            linka_run_reported rollback linka_rollback
            end_session
            ;;
        doctor)
            linka_doctor
            ;;
        remove|--remove|uninstall|--uninstall)
            emergency_remove
            ;;
        kill|--kill)
            kill_serpantinum
            ;;
        auto|--auto)
            shift
            auto_main "$@"
            ;;
        '')
            linka_main_menu
            ;;
        *)
            log_error "Неизвестный аргумент: $1"
            usage
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    case "${1:-}" in
        -h|--help) ;;
        *) preflight ;;
    esac

    main "$@"
fi
