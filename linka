    init_package_lists
    return 0
}

pkg_installed() {
    local pkg="$1"

    if [[ "$DISTRO" == 'fedora' ]]; then
        if rpm -q "$pkg" >/dev/null 2>&1; then
            return 0
        fi
        return 1
    fi

    # portageq есть всегда (sys-apps/portage); has_version как отдельная
    # команда вне ebuild-окружения не существует.
    if command -v portageq >/dev/null 2>&1; then
        if portageq has_version / "$pkg" >/dev/null 2>&1; then
            return 0
        fi
        return 1
    fi

    if command -v qlist >/dev/null 2>&1; then
        if qlist -I "$pkg" >/dev/null 2>&1; then
            return 0
        fi
        return 1
    fi

    return 2
}

