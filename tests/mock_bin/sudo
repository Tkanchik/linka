#!/usr/bin/env bash
# Mock sudo interceptor for linka E2E tests
set -euo pipefail

MOCK_LOGS="${MOCK_LOGS:-/tmp/linka_test_logs}"
MOCK_ROOT="${MOCK_ROOT:-/tmp/linka_test_root}"
mkdir -p "$MOCK_LOGS" "$MOCK_ROOT"

echo "$@" >> "$MOCK_LOGS/sudo.log"

# Filter out sudo-specific flags
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|-v|-k)
            shift
            ;;
        -l)
            # auto_sudo_ok checks `sudo -n -k -l`
            if [[ -n "${MOCK_SUDO_FAIL:-}" ]]; then
                exit 1
            fi
            exit 0
            ;;
        --)
            shift
            args+=("$@")
            break
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

if [[ ${#args[@]} -eq 0 ]]; then
    exit 0
fi

if [[ -n "${MOCK_SUDO_FAIL:-}" ]]; then
    echo "sudo: password required" >&2
    exit 1
fi

cmd="${args[0]}"
cmd_args=("${args[@]:1}")

# Path remapping helper for filesystem modifications
remap_arg() {
    local a="$1"
    if [[ "$a" == /etc/* || "$a" == /usr/* ]]; then
        printf '%s%s' "$MOCK_ROOT" "$a"
    else
        printf '%s' "$a"
    fi
}

case "$cmd" in
    mkdir)
        new_args=()
        for a in "${cmd_args[@]}"; do
            new_args+=("$(remap_arg "$a")")
        done
        exec /bin/mkdir "${new_args[@]}"
        ;;
    cp)
        new_args=()
        for a in "${cmd_args[@]}"; do
            new_args+=("$(remap_arg "$a")")
        done
        # Ensure destination directory exists
        dest="${new_args[${#new_args[@]}-1]}"
        dest_dir="$(dirname "$dest")"
        mkdir -p "$dest_dir"
        exec /bin/cp "${new_args[@]}"
        ;;
    touch)
        new_args=()
        for a in "${cmd_args[@]}"; do
            target="$(remap_arg "$a")"
            if [[ "$target" != -* ]]; then
                mkdir -p "$(dirname "$target")"
            fi
            new_args+=("$target")
        done
        exec /usr/bin/touch "${new_args[@]}"
        ;;
    chmod)
        new_args=()
        for a in "${cmd_args[@]}"; do
            new_args+=("$(remap_arg "$a")")
        done
        exec /bin/chmod "${new_args[@]}"
        ;;
    tee)
        new_args=()
        for a in "${cmd_args[@]}"; do
            target="$(remap_arg "$a")"
            if [[ "$target" != -* ]]; then
                mkdir -p "$(dirname "$target")"
            fi
            new_args+=("$target")
        done
        exec /usr/bin/tee "${new_args[@]}"
        ;;
    ln)
        new_args=()
        for a in "${cmd_args[@]}"; do
            new_args+=("$(remap_arg "$a")")
        done
        dest="${new_args[${#new_args[@]}-1]}"
        mkdir -p "$(dirname "$dest")"
        exec /bin/ln "${new_args[@]}"
        ;;
    rm)
        new_args=()
        for a in "${cmd_args[@]}"; do
            new_args+=("$(remap_arg "$a")")
        done
        exec /bin/rm "${new_args[@]}"
        ;;
    sed)
        new_args=()
        for a in "${cmd_args[@]}"; do
            new_args+=("$(remap_arg "$a")")
        done
        exec /bin/sed "${new_args[@]}"
        ;;
    *)
        exec "$cmd" "${cmd_args[@]}"
        ;;
esac
