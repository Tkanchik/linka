#!/usr/bin/env bash
# Mock RPM tool for linka E2E tests
set -euo pipefail

MOCK_LOGS="${MOCK_LOGS:-/tmp/linka_test_logs}"
MOCK_RPM_STATE="${MOCK_RPM_STATE:-/tmp/linka_test_rpm_state}"
mkdir -p "$MOCK_LOGS" "$MOCK_RPM_STATE"

echo "$0 $*" >> "$MOCK_LOGS/rpm.log"

installed_file="$MOCK_RPM_STATE/installed_pkgs"
provides_file="$MOCK_RPM_STATE/provides"

installed_pkgs="${MOCK_RPM_INSTALLED_PKGS:-}"
if [[ -f "$installed_file" ]]; then
    installed_pkgs="$installed_pkgs $(cat "$installed_file")"
fi

is_query=0
whatprovides=""
targets=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -q|--query)
            is_query=1
            shift
            ;;
        --whatprovides)
            whatprovides="$2"
            shift 2
            ;;
        -*)
            shift
            ;;
        *)
            targets+=("$1")
            shift
            ;;
    esac
done

if [[ -n "$whatprovides" ]]; then
    # Check provides mapping
    # 1. From MOCK_RPM_PROVIDES env (space separated key:val)
    for pair in ${MOCK_RPM_PROVIDES:-}; do
        key="${pair%%:*}"
        val="${pair#*:}"
        if [[ "$key" == "$whatprovides" ]]; then
            echo "$val-1.0.0-1.fc41.x86_64"
            exit 0
        fi
    done
    # 2. From file
    if [[ -f "$provides_file" ]]; then
        while IFS=: read -r key val || [[ -n "$key" ]]; do
            if [[ "$key" == "$whatprovides" ]]; then
                echo "$val-1.0.0-1.fc41.x86_64"
                exit 0
            fi
        done < "$provides_file"
    fi
    exit 1
fi

if [[ "$is_query" -eq 1 ]]; then
    for target in "${targets[@]}"; do
        found=0
        for p in $installed_pkgs; do
            if [[ "$p" == "$target" ]]; then
                found=1
                break
            fi
        done
        if [[ "$found" -eq 0 ]]; then
            exit 1
        fi
    done
    exit 0
fi

exit 0
