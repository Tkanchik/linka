#!/usr/bin/env bash
# Mock systemctl tool for linka E2E tests
set -euo pipefail

MOCK_LOGS="${MOCK_LOGS:-/tmp/linka_test_logs}"
MOCK_SYSTEMCTL_STATE="${MOCK_SYSTEMCTL_STATE:-/tmp/linka_test_systemctl_state}"
mkdir -p "$MOCK_LOGS" "$MOCK_SYSTEMCTL_STATE"

echo "$0 $*" >> "$MOCK_LOGS/systemctl.log"

is_user=0
is_global=0
action=""
args=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --user)
            is_user=1
            shift
            ;;
        --global)
            is_global=1
            shift
            ;;
        --now|-q|--quiet)
            shift
            ;;
        *)
            if [[ -z "$action" ]]; then
                action="$1"
            else
                args+=("$1")
            fi
            shift
            ;;
    esac
done

user_units_file="$MOCK_SYSTEMCTL_STATE/user_units"
system_units_file="$MOCK_SYSTEMCTL_STATE/system_units"

case "$action" in
    list-unit-files)
        target="${args[0]:-}"
        units=""
        if [[ "$is_user" -eq 1 ]]; then
            units="${MOCK_SYSTEMD_USER_UNITS:-}"
            if [[ -f "$user_units_file" ]]; then
                units="$units $(cat "$user_units_file")"
            fi
        else
            units="${MOCK_SYSTEMD_SYSTEM_UNITS:-}"
            if [[ -f "$system_units_file" ]]; then
                units="$units $(cat "$system_units_file")"
            fi
        fi

        found=0
        for u in $units; do
            if [[ "$u" == "$target" || "$target" == "" || "$u" == *"$target"* ]]; then
                echo "$u  enabled"
                found=1
            fi
        done

        if [[ "$found" -eq 1 ]]; then
            exit 0
        else
            exit 1
        fi
        ;;

    enable)
        echo "ENABLE: user=$is_user global=$is_global units=${args[*]}" >> "$MOCK_LOGS/systemctl_enabled.log"
        exit "${MOCK_SYSTEMCTL_ENABLE_EXIT_CODE:-0}"
        ;;

    start)
        echo "START: user=$is_user units=${args[*]}" >> "$MOCK_LOGS/systemctl_started.log"
        exit "${MOCK_SYSTEMCTL_START_EXIT_CODE:-0}"
        ;;

    is-active|is-enabled)
        target="${args[0]:-}"
        units="${MOCK_SYSTEMD_SYSTEM_UNITS:-}"
        for u in $units; do
            if [[ "$u" == "$target" ]]; then
                echo "active"
                exit 0
            fi
        done
        exit 1
        ;;

    *)
        echo "systemctl unhandled: $action ${args[*]}" >> "$MOCK_LOGS/systemctl.log"
        exit 0
        ;;
esac
